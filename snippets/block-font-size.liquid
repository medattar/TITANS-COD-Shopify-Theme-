{%- comment -%}
  Applies one block's own font size so it wins over the theme heading
  styles and a parent section text style.
  Params: sel, mobile, desktop. Numbers are pixels unless unit is "none".
{%- endcomment -%}
{%- if sel != blank and mobile != blank and desktop != blank -%}
  {%- liquid
    assign size_unit = 'px'
    if unit == 'none'
      assign size_unit = ''
    endif
  -%}
  {% style %}
    #shopify-section-{{ section.id }} {{ sel }} {
      font-size: {{ mobile }}{{ size_unit }};
    }
    @media (min-width: 990px) {
      #shopify-section-{{ section.id }} {{ sel }} {
        font-size: {{ desktop }}{{ size_unit }};
      }
    }
  {% endstyle %}
{%- endif -%}
