{%- comment -%}
  Price display driven by real product/variant data.
  Params:
  - product (required)
  - variant (optional, defaults to selected or first available)
  - use_range: true to show "From" price when variants differ (cards)
  - show_compare (default true), show_savings (default false)
  - savings_format: 'amount' | 'percent'
  - class
  Elements carry data-* hooks so variant changes can update them client side.
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  assign price = target.price
  assign compare = target.compare_at_price
  if use_range and product.price_varies
    assign price = product.price_min
    assign compare = product.compare_at_price_min
  endif

  assign on_sale = false
  if compare > price
    assign on_sale = true
    assign saved = compare | minus: price
    assign percent = saved | times: 100.0 | divided_by: compare | round
  endif

-%}
<div
  class="price{% if on_sale %} price--sale{% endif %}{% if meta_layout == 'below' %} price--meta-below{% endif %}{% if class %} {{ class }}{% endif %}"
  style="{% if compare_size > 0 %}--compare-size: {{ compare_size }}px;{% endif %}{% if compare_size_mobile > 0 %}--compare-size-m: {{ compare_size_mobile }}px;{% endif %}{% if compare_color != blank and compare_color.alpha != 0 %}--compare-color: {{ compare_color }};{% endif %}{% if compare_line != blank and compare_line.alpha != 0 %}--compare-line: {{ compare_line }};{% endif %}{% if compare_weight != blank and compare_weight != 'inherit' %}--compare-weight: {{ compare_weight }};{% endif %}{% if compare_gap > 0 %}--compare-gap: {{ compare_gap }}px;{% endif %}{% if compare_letter != blank and compare_letter != 0 %}--compare-letter: {{ compare_letter | divided_by: 100.0 }}em;{% endif %}{% if save_size > 0 %}--save-size: {{ save_size }}px;{% endif %}{% if save_color != blank and save_color.alpha != 0 %}--save-color: {{ save_color }};{% endif %}{% if save_bg != blank and save_bg.alpha != 0 %}--save-bg: {{ save_bg }};{% endif %}{% if save_radius > 0 %}--save-radius: {{ save_radius }}px;{% endif %}{% if save_pad > 0 %}--save-pad: {{ save_pad }}px;{% endif %}"
>
  {%- if on_sale -%}<span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>{%- endif -%}
  <span class="price__current" data-price-current>
    {%- if use_range and product.price_varies -%}
      {{- 'products.product.from' | t }}&nbsp;
    {%- endif -%}
    {%- render 'format-money', amount: price -%}
  </span>
  {%- if show_compare != false or show_savings -%}<span class="price__meta">{%- endif -%}
  {%- unless show_compare == false -%}
    <s class="price__compare{% if compare_strike == false %} price__compare--plain{% endif %}" data-price-compare{% unless on_sale %} hidden{% endunless %}>
      {%- if on_sale -%}
        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
        {%- if compare_prefix != blank -%}<span class="price__compare-label">{{ compare_prefix | escape }}</span>{% endif -%}
        <span class="price__compare-amount"{% if compare_color != blank and compare_color.alpha != 0 or compare_line != blank and compare_line.alpha != 0 %} style="{% if compare_color != blank and compare_color.alpha != 0 %}color: {{ compare_color }};{% if compare_line == blank or compare_line.alpha == 0 %} text-decoration-color: {{ compare_color }};{% endif %}{% endif %}{% if compare_line != blank and compare_line.alpha != 0 %} text-decoration-color: {{ compare_line }};{% endif %}"{% endif %}>{% render 'format-money', amount: compare %}</span>
      {%- endif -%}
    </s>
  {%- endunless -%}
  {%- if show_savings -%}
    <span class="price__savings badge" data-price-savings data-savings-format="{{ savings_format | default: 'amount' }}"{% unless on_sale %} hidden{% endunless %}>
      {%- if on_sale -%}
        {%- capture saved_money %}{% render 'format-money', amount: saved %}{% endcapture -%}
        {%- assign saved_money = saved_money | strip -%}
        {%- if savings_text != blank -%}
          {{- savings_text | escape | replace: '[percent]', percent | replace: '[amount]', saved_money -}}
        {%- elsif savings_format == 'percent' -%}
          {{- 'products.product.save_percent' | t: percent: percent -}}
        {%- else -%}
          {{- 'products.product.save_amount' | t: amount: saved_money -}}
        {%- endif -%}
      {%- endif -%}
    </span>
  {%- endif -%}
  {%- if show_compare != false or show_savings -%}</span>{%- endif -%}
  {%- if target.unit_price_measurement -%}
    <small class="unit-price">
      {%- render 'format-money', amount: target.unit_price -%}/
      {%- if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif -%}
      {{- target.unit_price_measurement.reference_unit -}}
    </small>
  {%- endif -%}
</div>
