{%- comment -%}
  Responsive image with srcset/sizes, explicit dimensions and focal point.
  Params:
  - image (required)
  - sizes: sizes attribute (default 100vw)
  - widths: comma separated widths
  - loading: 'lazy' (default) or 'eager'
  - priority: true to set fetchpriority=high
  - class, alt
{%- endcomment -%}
{%- liquid
  assign img_sizes = sizes | default: '100vw'
  assign img_widths = widths | default: '360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2160'
  assign img_loading = loading | default: 'lazy'
  assign img_alt = alt | default: image.alt | escape
  assign focal = image.presentation.focal_point | default: 'center'
  assign img_style = 'object-position: ' | append: focal | append: ';'
  assign fetch = 'auto'
  if priority
    assign fetch = 'high'
  endif
-%}
{{-
  image
  | image_url: width: 2160
  | image_tag:
    widths: img_widths,
    sizes: img_sizes,
    loading: img_loading,
    fetchpriority: fetch,
    class: class,
    alt: img_alt,
    style: img_style
-}}
