{%- comment -%} Cart line items shared by the cart drawer and the cart page. {%- endcomment -%}
<ul class="cart-items" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
      <a href="{{ item.url }}" class="cart-item__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {{ item.image | image_url: width: 180 | image_tag: loading: 'lazy', width: 76, height: 76, alt: item.image.alt }}
        {%- endif -%}
      </a>

      <div class="cart-item__details">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__meta">{{ item.variant.title | escape }}</p>
        {%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="cart-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}
          <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {%- endif -%}
        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="cart-item__discounts" role="list">
            {%- for discount in item.line_level_discount_allocations -%}
              <li>{{ discount.discount_application.title }} (−{% render 'format-money', amount: discount.amount %})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cart-item__controls">
          <quantity-input class="quantity quantity--small">
            <button type="button" class="quantity__button" data-qty="minus" aria-label="{{ 'cart.general.decrease' | t: product: item.product.title | escape }}">
              {%- render 'icon', icon: 'minus' -%}
            </button>
            <input
              class="quantity__input"
              type="number"
              inputmode="numeric"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              {% if item.variant.quantity_rule.max != null %}
                max="{{ item.variant.quantity_rule.max }}"
              {% endif %}
              step="{{ item.variant.quantity_rule.increment | default: 1 }}"
              data-line="{{ item.index | plus: 1 }}"
              data-key="{{ item.key }}"
              aria-label="{{ 'cart.general.quantity_for' | t: product: item.product.title | escape }}"
            >
            <button type="button" class="quantity__button" data-qty="plus" aria-label="{{ 'cart.general.increase' | t: product: item.product.title | escape }}">
              {%- render 'icon', icon: 'plus' -%}
            </button>
          </quantity-input>
          <button type="button" class="cart-item__remove" data-remove-line="{{ item.index | plus: 1 }}" data-key="{{ item.key }}">
            {{- 'cart.general.remove' | t -}}
          </button>
        </div>
      </div>

      <div class="cart-item__price">
        <div class="price">
          <span class="price__current">{% render 'format-money', amount: item.final_line_price %}</span>
          {%- if item.original_line_price > item.final_line_price -%}
            <s class="price__compare"><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{% render 'format-money', amount: item.original_line_price %}</s>
          {%- elsif item.variant.compare_at_price > item.variant.price -%}
            {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
            <s class="price__compare"><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{% render 'format-money', amount: compare_line %}</s>
          {%- endif -%}
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
