{%- comment -%}
  Per-block / per-section style overrides from the shared "Box style" and "Text style" settings.
  Params:
  - bs: the settings object (block.settings or section.settings)
  - sel: CSS selector of the element to style
  - clip: true to clip children to the corner radius (blocks only; sections may contain sticky children)
{%- endcomment -%}
{%- if bs.box_enable or bs.tx_enable -%}
  {%- style -%}
    {%- if bs.box_enable -%}
      {%- liquid
        assign box_root = sel
        unless sel contains 'shopify-section'
          assign box_root = '#shopify-section-' | append: section.id | append: ' ' | append: sel
        endunless
        case bs.box_shadow
          when 'soft'
            assign shadow_alpha = bs.box_shadow_color | color_modify: 'alpha', 0.16
            assign shadow = '0 10px 30px ' | append: shadow_alpha
          when 'medium'
            assign shadow_alpha = bs.box_shadow_color | color_modify: 'alpha', 0.24
            assign shadow = '0 16px 40px ' | append: shadow_alpha
          when 'hard'
            assign shadow = '5px 5px 0 ' | append: bs.box_shadow_color
          when 'glow'
            assign shadow_alpha = bs.box_shadow_color | color_modify: 'alpha', 0.45
            assign shadow = '0 0 26px ' | append: shadow_alpha
          else
            assign shadow = 'none'
        endcase
      -%}
      {{ box_root }} {
        margin-top: {{ bs.box_mt_m }}px;
        margin-bottom: {{ bs.box_mb_m }}px;
        {%- if bs.box_py != nil %}
          padding: {{ bs.box_py_m }}px {{ bs.box_px_m }}px;
        {%- endif %}
        {%- if bs.box_inset > 0 %}
          margin-inline: {{ bs.box_inset | at_most: 16 }}px;
        {%- endif %}
        {%- liquid
          assign radius_tl = bs.box_radius
          assign radius_tr = bs.box_radius
          assign radius_br = bs.box_radius
          assign radius_bl = bs.box_radius
          if bs.box_radius_split
            assign radius_tl = bs.box_radius_tl
            assign radius_tr = bs.box_radius_tr
            assign radius_br = bs.box_radius_br
            assign radius_bl = bs.box_radius_bl
          endif
        -%}
        border-radius: {{ radius_tl }}px {{ radius_tr }}px {{ radius_br }}px {{ radius_bl }}px;
        {%- if bs.box_border_width > 0 %}
          border: {{ bs.box_border_width }}px {{ bs.box_border_style }} {{ bs.box_border_color | default: 'currentColor' }};
        {%- endif %}
        {%- if bs.box_bg != blank and bs.box_bg.alpha != 0 %}
          background: {{ bs.box_bg }};
        {%- endif %}
        {%- if bs.box_bg_gradient != blank %}
          background: {{ bs.box_bg_gradient }};
        {%- endif %}
        {%- unless shadow == 'none' %}
          box-shadow: {{ shadow }};
        {%- endunless %}
        {%- if bs.box_max_width > 0 %}
          max-width: {{ bs.box_max_width }}px;
          {%- case bs.box_align -%}
            {%- when 'center' %} margin-inline: auto;
            {%- when 'right' %} margin-inline: auto 0;
            {%- else %} margin-inline: 0 auto;
          {%- endcase -%}
        {%- endif %}
        {%- if clip and bs.box_radius > 0 %}
          overflow: hidden;
        {%- endif %}
        {%- if bs.box_effect != 'none' %}
          transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
        {%- endif %}
      }
      @media (min-width: 750px) {
        {{ box_root }} {
          margin-top: {{ bs.box_mt }}px;
          margin-bottom: {{ bs.box_mb }}px;
          {%- if bs.box_py != nil %}
            padding: {{ bs.box_py }}px {{ bs.box_px }}px;
          {%- endif %}
          {%- if bs.box_inset > 0 %}
            margin-inline: {{ bs.box_inset }}px;
          {%- endif %}
        }
      }
      @media (hover: hover) and (prefers-reduced-motion: no-preference) {
        {%- case bs.box_effect -%}
          {%- when 'lift' %}
            {{ box_root }}:hover { transform: translateY(-4px); }
          {%- when 'grow' %}
            {{ box_root }}:hover { transform: scale(1.03); }
          {%- when 'glow' %}
            {{ box_root }}:hover { box-shadow: 0 0 0 3px {{ bs.box_shadow_color | color_modify: 'alpha', 0.25 }}, 0 12px 34px {{ bs.box_shadow_color | color_modify: 'alpha', 0.3 }}; }
          {%- when 'dim' %}
            {{ box_root }}:hover { filter: brightness(0.94); }
        {%- endcase %}
      }
    {%- endif -%}

    {%- if bs.tx_enable -%}
      {%- liquid
        assign font_root = sel
        unless sel contains 'shopify-section'
          assign font_root = '#shopify-section-' | append: section.id | append: ' ' | append: sel
        endunless
        assign tx_targets = 'h1, h2, h3, h4, h5, h6, p, li, span, a, b, strong, em, div, label, summary, button, small, .button, .heading-block, .block-heading, .product-title, .product-subtitle, .price__current, .countdown__value, .countdown__unit, .badge, .eyebrow, .rte'
      -%}
      {{ font_root }},
      {{ font_root }} :is({{ tx_targets }}) {
        {%- if bs.tx_font != 'inherit' %}
          font-family: var(--font-{{ bs.tx_font }}-family) !important;
        {%- endif %}
        {%- if bs.tx_weight != 'inherit' %}
          font-weight: {{ bs.tx_weight }} !important;
        {%- endif %}
        letter-spacing: {{ bs.tx_letter | default: 0 | divided_by: 100.0 }}em !important;
        word-spacing: {{ bs.tx_word | default: 0 | divided_by: 100.0 }}em !important;
        {%- if bs.tx_line > 0 %}
          line-height: {{ bs.tx_line | divided_by: 10.0 }} !important;
        {%- endif %}
        {%- if bs.tx_transform != 'inherit' %}
          text-transform: {{ bs.tx_transform }} !important;
        {%- endif %}
        {%- if bs.tx_color != blank and bs.tx_color.alpha != 0 %}
          color: {{ bs.tx_color }} !important;
        {%- endif %}
      }
      {%- if bs.tx_align != 'inherit' %}
        {{ font_root }} {
          text-align: {{ bs.tx_align }} !important;
          justify-content: {% case bs.tx_align %}{% when 'center' %}center{% when 'right' %}flex-end{% else %}flex-start{% endcase %} !important;
        }
      {%- endif %}
      {%- if bs.tx_size_m > 0 or bs.tx_size > 0 %}
        {{ font_root }},
        {{ font_root }} :is({{ tx_targets }}) {
          {%- if bs.tx_size_m > 0 %} font-size: {{ bs.tx_size_m }}px !important;{% endif %}
        }
        @media (min-width: 750px) {
          {{ font_root }},
          {{ font_root }} :is({{ tx_targets }}) {
            {%- if bs.tx_size > 0 %} font-size: {{ bs.tx_size }}px !important;{% endif %}
          }
        }
      {%- endif %}
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}
