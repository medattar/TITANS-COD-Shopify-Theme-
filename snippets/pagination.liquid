{%- comment -%}
  Accessible pagination. Params: paginate (required), anchor (optional, e.g. '#results')
{%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination-wrapper" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination" role="list">
      {%- if paginate.previous -%}
        <li>
          <a href="{{ paginate.previous.url }}{{ anchor }}" aria-label="{{ 'general.pagination.previous' | t }}" data-facet-link>
            {%- render 'icon', icon: 'chevron-left' -%}
          </a>
        </li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}{{ anchor }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}" data-facet-link>{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span aria-current="page" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li>
          <a href="{{ paginate.next.url }}{{ anchor }}" aria-label="{{ 'general.pagination.next' | t }}" data-facet-link>
            {%- render 'icon', icon: 'chevron-right' -%}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
