{%- comment -%}
  Star rating from real rating data. Params: rating (number), scale (default 5), count (optional), label (optional)
{%- endcomment -%}
{%- liquid
  assign rating_scale = scale | default: 5
  assign pct = rating | times: 100.0 | divided_by: rating_scale
-%}
<span class="stars" role="img" aria-label="{{ 'accessibility.star_rating' | t: rating: rating, max: rating_scale }}">
  <span class="stars__fill" style="width: {{ pct }}%;"></span>
</span>
{%- if count != blank and count > 0 -%}
  <span class="stars__count">({{ count }})</span>
{%- endif -%}
