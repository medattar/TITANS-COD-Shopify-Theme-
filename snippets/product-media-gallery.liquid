{%- comment -%}
  Product media gallery: swipeable viewer + thumbnail rail.
  Params: product, section (settings: gallery_layout, media_ratio, media_fit, media_border,
  media_shadow, thumbs_mobile, video_loop), priority (bool, first media eager)
  Optional, from the Product media block (blank or 'section' keeps the section style):
  layout (slider | thumbs_bottom | thumbs_left | single | stacked | grid), arrows (show | hover | hide),
  arrows_mobile, counter, gap, ratio, radius
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign featured = product.selected_or_first_available_variant.featured_media | default: product.featured_media
  assign pm = layout | default: 'section'
  assign media_ratio = s.media_ratio
  if ratio != blank and ratio != 'section'
    assign media_ratio = ratio
  endif
  assign show_thumbs = true
  if s.gallery_layout == 'stacked'
    assign show_thumbs = false
  endif
  assign show_nav = true
  case pm
    when 'slider'
      assign show_thumbs = false
    when 'thumbs_bottom', 'thumbs_left'
      assign show_thumbs = true
    when 'single', 'stacked', 'grid'
      assign show_thumbs = false
      assign show_nav = false
  endcase
  assign gallery_class = ''
  if pm != 'section'
    assign gallery_class = ' gallery--pm gallery--pm-' | append: pm
    if show_nav
      assign gallery_class = gallery_class | append: ' gallery--arrows-' | append: arrows
      if arrows_mobile
        assign gallery_class = gallery_class | append: ' gallery--arrows-mobile'
      endif
      if counter == false
        assign gallery_class = gallery_class | append: ' gallery--no-counter'
      endif
    endif
  endif
  case media_ratio
    when 'square'
      assign gallery_ratio = '1 / 1'
    when 'portrait'
      assign gallery_ratio = '4 / 5'
    when 'landscape'
      assign gallery_ratio = '4 / 3'
    else
      if product.featured_media
        assign gallery_ratio = product.featured_media.aspect_ratio | default: 1
      else
        assign gallery_ratio = '4 / 5'
      endif
  endcase
  assign media_count = product.media.size
  capture main_sizes
    echo '(min-width: 990px) calc(min(100vw, ' | append: settings.page_width | append: 'px) * 0.52), 100vw'
  endcapture
-%}

<media-gallery
  class="gallery gallery--{{ s.gallery_layout }}{% unless s.thumbs_mobile %} gallery--no-thumbs-mobile{% endunless %}{% if s.media_border %} gallery--bordered{% endif %}{% if s.media_shadow %} gallery--shadow{% endif %}{{ gallery_class }}"
  style="--gallery-ratio: {{ gallery_ratio }}; --gallery-fit: {{ s.media_fit }};{% if radius > 0 %} --media-radius: {{ radius }}px;{% endif %}{% if pm == 'stacked' or pm == 'grid' %} --pm-gap: {{ gap | default: 10 }}px;{% endif %}"
  data-section-id="{{ section.id }}"
  role="region"
  aria-label="{{ 'products.product.media.gallery_viewer' | t }}"
>
  {%- if media_count > 0 -%}
    <div class="gallery__viewer">
      <ul class="gallery__track" role="list" data-gallery-track tabindex="0" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
        {%- for media in product.media -%}
          {%- liquid
            assign is_active = false
            if featured.id == media.id
              assign is_active = true
            elsif featured == blank and forloop.first
              assign is_active = true
            endif
            assign loading = 'lazy'
            assign fetch = 'auto'
            if pm == 'single' and is_active == false
              continue
            endif
            if forloop.first and priority
              assign loading = 'eager'
              assign fetch = 'high'
            endif
          -%}
          <li
            class="gallery__slide{% if is_active %} is-active{% endif %}"
            data-media-id="{{ media.id }}"
            data-index="{{ forloop.index0 }}"
            aria-roledescription="{{ 'products.product.media.slide' | t }}"
            aria-label="{{ forloop.index }} / {{ media_count }}"
          >
            {%- case media.media_type -%}
              {%- when 'image' -%}
                <div class="gallery__media media">
                  {{
                    media
                    | image_url: width: 1800
                    | image_tag:
                      widths: '400, 600, 800, 1000, 1200, 1500, 1800',
                      sizes: main_sizes,
                      loading: loading,
                      fetchpriority: fetch,
                      alt: media.alt
                  }}
                </div>
              {%- when 'video', 'external_video' -%}
                <deferred-media class="gallery__media media deferred-media"{% if s.video_autoplay %} data-autoplay{% endif %}>
                  <button type="button" class="deferred-media__poster" data-deferred-poster aria-label="{{ 'products.product.media.play_video' | t }}">
                    {{
                      media.preview_image
                      | image_url: width: 1400
                      | image_tag: widths: '400, 700, 1000, 1400', sizes: main_sizes, loading: loading, alt: media.alt
                    }}
                    <span class="play-button" aria-hidden="true">{%- render 'icon', icon: 'play' -%}</span>
                  </button>
                  <template>
                    {%- if media.media_type == 'video' -%}
                      {{ media | video_tag: controls: true, playsinline: true, loop: s.video_loop, preload: 'none', image_size: '1400x' }}
                    {%- else -%}
                      {{ media | external_video_tag: loading: 'lazy' }}
                    {%- endif -%}
                  </template>
                </deferred-media>
              {%- when 'model' -%}
                <div class="gallery__media media">
                  {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
                </div>
            {%- endcase -%}
          </li>
        {%- endfor -%}
      </ul>

      {%- if media_count > 1 and show_nav -%}
        <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
          {%- render 'icon', icon: 'chevron-left' -%}
        </button>
        <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'accessibility.next_slide' | t }}">
          {%- render 'icon', icon: 'chevron-right' -%}
        </button>
        <div class="gallery__counter" aria-hidden="true"><span data-gallery-current>1</span>/{{ media_count }}</div>
      {%- endif -%}
    </div>

    {%- if media_count > 1 and show_thumbs -%}
      <div class="gallery__thumbs" data-gallery-thumbs>
        {%- for media in product.media -%}
          <button
            type="button"
            class="gallery__thumb"
            data-thumb-index="{{ forloop.index0 }}"
            data-media-id="{{ media.id }}"
            aria-label="{{ 'products.product.media.load_media' | t: index: forloop.index }}"
            {% if featured.id == media.id or featured == blank and forloop.first %}
              aria-current="true"
            {% endif %}
          >
            {{ media.preview_image | image_url: width: 200, height: 200, crop: 'center' | image_tag: loading: 'lazy', width: 100, height: 100, alt: '' }}
            {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
              <span class="gallery__thumb-play" aria-hidden="true">{%- render 'icon', icon: 'play' -%}</span>
            {%- endif -%}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="gallery__viewer">
      <div class="gallery__media media placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    </div>
  {%- endif -%}
</media-gallery>
