{%- comment -%}
  Blog article card. Params: article (required), show_excerpt, show_date, eager
{%- endcomment -%}
<article class="article-card lf-card">
  <a class="article-card__media media" href="{{ article.url }}" tabindex="-1" aria-hidden="true" style="--ratio: 4 / 3;">
    {%- if article.image -%}
      {%- liquid
        if eager
          render 'image', image: article.image, sizes: '(min-width: 990px) 33vw, 100vw', loading: 'eager'
        else
          render 'image', image: article.image, sizes: '(min-width: 990px) 33vw, 100vw'
        endif
      -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </a>
  <div class="article-card__body">
    {%- if show_date -%}
      <small class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</small>
    {%- endif -%}
    <h2 class="article-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
    {%- if show_excerpt -%}
      <p class="article-card__excerpt">
        {%- if article.excerpt != blank -%}{{ article.excerpt | strip_html | truncatewords: 26 }}{%- else -%}{{ article.content | strip_html | truncatewords: 26 }}{%- endif -%}
      </p>
    {%- endif -%}
    <a class="link article-card__more" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a>
  </div>
</article>
