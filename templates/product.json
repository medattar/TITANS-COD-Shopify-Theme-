      "blocks": {
        "question_Tj9Pxc": {
          "type": "question",
          "settings": {
            "question": "Envíos y devoluciones",
            "answer": "<p>Todos los pedidos son procesados ​​por nuestro equipo de logística, que se encarga de que se esfuercen al máximo, en un plazo de 24 a 72 horas. Los plazos de entrega, dependiendo de su ubicación, oscilarán entre 2 y 10 días.</p>"
          }
        },
        "question_pDMEcC": {
          "type": "question",
          "settings": {
            "question": "Nuestra garantía para usted",
            "answer": "<p>Queremos que quede completamente satisfecho con su compra, y por eso ofrecemos una garantía de devolución de dinero de 30 días.</p>"
          }
        }
      },
