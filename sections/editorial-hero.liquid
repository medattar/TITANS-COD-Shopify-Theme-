      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 32,
      "max": 90,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "List card"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Card title",
      "default": "TU LISTA DE HOY"
    },
    {
      "type": "text",
      "id": "card_total",
      "label": "Card footer label",
      "default": "PENDIENTE"
    },
    {
      "type": "text",
      "id": "card_quote",
      "label": "Card quote",
      "default": "“Te toca a ti.”"
    },
    {
      "type": "checkbox",
      "id": "show_barcode",
      "label": "Show decorative barcode",
      "default": true
    },
    {
      "type": "header",
      "content": "Intro card"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Text",
      "default": "<p>Cuéntale a tu cliente en una frase por qué este producto encaja en su rutina.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Lo quiero"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "#buy",
      "info": "URL or #anchor. #buy scrolls to the product purchase area."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 84
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
