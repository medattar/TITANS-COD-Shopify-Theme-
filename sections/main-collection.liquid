    },
    {
      "type": "range",
      "id": "tx_size_m",
      "label": "Font size, mobile (0 = default)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_letter",
      "label": "Letter spacing (1/100 em)",
      "min": -10,
      "max": 40,
      "step": 1,
      "default": 0,
