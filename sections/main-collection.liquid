{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign s = section.settings
  assign card_vw = 100 | divided_by: s.columns_desktop
  assign card_sizes = '(min-width: 990px) ' | append: card_vw | append: 'vw, (min-width: 750px) 33vw, 50vw'
  assign catalog = collection
  if catalog == blank
    assign catalog = collections.all
  endif
  assign per_page = s.products_per_page | default: 24
-%}

{%- if catalog != blank -%}
{%- paginate catalog.products by per_page -%}
  <facet-filters class="section collection color-{% render 'scheme', s: s, area: 'sections' %} gradient" style="{% render 'section-style' %}" data-section-id="{{ section.id }}">
    <div class="page-width">
      <header class="collection__header text-{{ s.header_align }}">
        {%- if s.show_breadcrumbs -%}
          <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
            <ol>
              <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
              <li aria-current="page">{{ catalog.title | escape }}</li>
            </ol>
          </nav>
        {%- endif -%}
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        <h1 class="h1 collection__title">{{ catalog.title | escape }}</h1>
        {%- if s.show_description and catalog.description != blank -%}
          <div class="rte lead collection__description">{{ catalog.description }}</div>
        {%- endif -%}
      </header>

      {%- if s.enable_filtering or s.enable_sorting -%}
        {%- render 'facets',
          results: catalog,
          sort_by: catalog.sort_by,
          default_sort_by: catalog.default_sort_by,
          enable_filtering: s.enable_filtering,
          enable_sorting: s.enable_sorting,
          count: catalog.products_count
        -%}
      {%- endif -%}

      <div class="collection__results" id="CollectionResults-{{ section.id }}" data-facet-update="results">
        {%- if catalog.products.size > 0 -%}
          <ul class="grid collection__grid" role="list" style="--cols-mobile: {{ s.columns_mobile }}; --cols-tablet: {{ s.columns_desktop | at_most: 3 }}; --cols-desktop: {{ s.columns_desktop }};">
            {%- for product in catalog.products -%}
              <li class="collection__item">
                {%- liquid
                  assign eager = false
                  if forloop.index <= cols_mobile
                    assign eager = true
                  endif
                  render 'product-card', product: product, sizes: card_sizes, eager: eager
                -%}
              </li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="collection__empty">
            {%- if catalog.filters.size > 0 and catalog.products_count == 0 and catalog.all_products_count > 0 -%}
              <h2 class="h3">{{ 'products.facets.no_results' | t }}</h2>
              <a class="button button--outline" href="{{ catalog.url }}" data-facet-link>{{ 'products.facets.clear_all' | t }}</a>
            {%- else -%}
              <h2 class="h3">{{ 'collections.general.empty' | t }}</h2>
              <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </facet-filters>
{%- endpaginate -%}
{%- endif -%}

{% schema %}
{
  "name": "Collection products",
  "class": "section-main-collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    { "type": "checkbox", "id": "own_colors", "label": "Keep this color scheme", "info": "When Theme settings > Color template is applied, this section keeps the scheme above.", "default": false },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Pago contra entrega ✦"
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Configure filters with the Shopify Search & Discovery app."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_inset",
      "label": "Side inset",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "box_radius_split",
      "label": "Different radius on each corner",
      "default": false,
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "range",
      "id": "box_radius_tl",
      "label": "Top left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_tr",
      "label": "Top right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_br",
      "label": "Bottom right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
