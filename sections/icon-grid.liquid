{%- liquid
  assign show_here = true
  if section.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = section.settings.product | default: product
    assign show_ids = section.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
{%- capture ig_vars -%}
  --ig-icon: {{ s.icon_size_mobile }}px; --ig-icon-d: {{ s.icon_size }}px; --ig-image: {{ s.image_width_mobile }}px; --ig-image-d: {{ s.image_width }}px; --ig-gap: {{ s.item_gap }}px;
  {%- if s.icon_color != blank and s.icon_color.alpha != 0 %} --ig-icon-color: {{ s.icon_color }};{% endif -%}
  {%- if s.icon_bg != blank and s.icon_bg.alpha != 0 %} --ig-icon-bg: {{ s.icon_bg }};{% endif -%}
  {%- if s.title_font != 'auto' %} --ig-title-font: var(--font-{{ s.title_font }}-family); --ig-title-weight: var(--font-{{ s.title_font }}-weight);{% endif -%}
  {%- if s.title_weight != 'auto' %} --ig-title-weight: {{ s.title_weight }};{% endif -%}
  {%- if s.title_size > 0 %} --ig-title-size-d: {{ s.title_size }}px;{% endif -%}
  {%- if s.title_size_mobile > 0 %} --ig-title-size: {{ s.title_size_mobile }}px;{% endif -%}
  {%- if s.title_transform != 'auto' %} --ig-title-transform: {{ s.title_transform }};{% endif -%}
  {%- if s.title_letter_spacing != 0 %} --ig-title-letter: {{ s.title_letter_spacing | divided_by: 100.0 }}em;{% endif -%}
  {%- if s.title_color != blank and s.title_color.alpha != 0 %} --ig-title-color: {{ s.title_color }};{% endif -%}
  {%- if s.text_size > 0 %} --ig-text-size: {{ s.text_size }}px;{% endif -%}
  {%- if s.text_color != blank and s.text_color.alpha != 0 %} --ig-text-color: {{ s.text_color }};{% endif -%}
{%- endcapture -%}
<section
  class="section lf-section color-{% render 'scheme', s: s, area: 'sections' %} gradient icon-grid icon-grid--{{ s.style }} icon-grid--shape-{{ s.icon_shape }}{% if s.dividers %} icon-grid--dividers{% endif %}"
  style="{% render 'section-style' %} {{ ig_vars | strip_newlines }}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}
    <ul class="grid icon-grid__list" role="list" style="--cols-mobile: {{ s.columns_mobile }}; --cols-tablet: {{ s.columns_desktop | at_most: 3 }}; --cols-desktop: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="icon-grid__item icon-grid__item--{{ s.align }}{% if s.style == 'cards' %} lf-card{% endif %}"{% if b.icon_color != blank and b.icon_color.alpha != 0 or b.icon_bg != blank and b.icon_bg.alpha != 0 %} style="{% if b.icon_color != blank and b.icon_color.alpha != 0 %}--ig-icon-color: {{ b.icon_color }};{% endif %}{% if b.icon_bg != blank and b.icon_bg.alpha != 0 %}--ig-icon-bg: {{ b.icon_bg }}; --ig-item-bg: {{ b.icon_bg }}; --ig-icon-border: {{ b.icon_bg }};{% endif %}"{% endif %} {{ block.shopify_attributes }}>
          {%- if b.link != blank -%}<a class="icon-grid__link" href="{{ b.link }}">{%- endif -%}
          {%- if b.image != blank -%}
            <span class="icon-grid__image{% if s.image_style == 'photo' %} icon-grid__image--photo{% endif %}">
              {{ b.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: b.image.alt }}
            </span>
          {%- elsif b.icon != 'none' -%}
            <span class="icon-grid__icon">{%- render 'icon', icon: b.icon -%}</span>
          {%- endif -%}
          <div class="icon-grid__body">
            {%- if b.title != blank -%}<h3 class="icon-grid__title">{{ b.title }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<div class="icon-grid__text rte">{{ b.text }}</div>{%- endif -%}
          </div>
          {%- if b.value != blank -%}<span class="icon-grid__value">{{ b.value }}</span>{%- endif -%}
          {%- if b.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="lf-cta-row"><a class="button" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="page-width"><div class="theme-placeholder">Hidden on this product. Change Show on to display this section here.</div></div>
{%- endif -%}

