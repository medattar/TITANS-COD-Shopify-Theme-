{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{%- assign s = section.settings -%}
<section class="section color-{% render 'scheme', s: s, area: 'sections' %} gradient" style="{% render 'section-style' %}">
  <div class="page-width page-width--narrow text-center not-found">
    <p class="eyebrow">404</p>
    <h1 class="h1">{{ 'templates.404.title' | t }}</h1>
    <p class="lead">{{ 'templates.404.subtext' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'templates.search.placeholder' | t }}</label>
      <div class="search-field">
        <input id="NotFoundSearch" class="field__input" type="search" name="q" placeholder="{{ 'templates.search.placeholder' | t }}">
        <button type="submit" class="search-field__submit" aria-label="{{ 'templates.search.submit' | t }}">{%- render 'icon', icon: 'search' -%}</button>
      </div>
      <input type="hidden" name="options[prefix]" value="last">
    </form>
    <a class="button button--outline" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
  </div>
</section>

{% stylesheet %}
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .not-found .h1 {
    margin: 0;
  }

  .not-found .search-page__form {
    width: 100%;
    max-width: 520px;
  }
{% endstylesheet %}

{% schema %}
