{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}
    <div class="before-after before-after--{{ s.style }}" style="--ba-cols: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="before-after__item lf-card" {{ block.shopify_attributes }}>
          {%- if s.style == 'slider' -%}
            <before-after-slider class="before-after__slider media" style="--ratio: {{ s.ratio }}; --pos: 50%;">
              <div class="before-after__layer before-after__layer--after">
                {%- if b.after != blank -%}{%- render 'image', image: b.after, sizes: '(min-width: 990px) 50vw, 100vw' -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                <span class="before-after__label before-after__label--after">{{ b.after_label }}</span>
              </div>
              <div class="before-after__layer before-after__layer--before">
                {%- if b.before != blank -%}{%- render 'image', image: b.before, sizes: '(min-width: 990px) 50vw, 100vw' -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                <span class="before-after__label">{{ b.before_label }}</span>
              </div>
              <span class="before-after__handle" aria-hidden="true">{%- render 'icon', icon: 'chevron-left' -%}{%- render 'icon', icon: 'chevron-right' -%}</span>
              <input class="before-after__range" type="range" min="0" max="100" value="50" aria-label="{{ 'sections.before_after.slider_label' | t }}">
            </before-after-slider>
          {%- else -%}
            <div class="before-after__pair">
              <figure class="media" style="--ratio: {{ s.ratio }};">
                {%- if b.before != blank -%}{%- render 'image', image: b.before, sizes: '(min-width: 990px) 25vw, 50vw' -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                <figcaption class="before-after__label">{{ b.before_label }}</figcaption>
              </figure>
              <figure class="media" style="--ratio: {{ s.ratio }};">
                {%- if b.after != blank -%}{%- render 'image', image: b.after, sizes: '(min-width: 990px) 25vw, 50vw' -%}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                <figcaption class="before-after__label before-after__label--after">{{ b.after_label }}</figcaption>
              </figure>
            </div>
          {%- endif -%}
          {%- if b.title != blank or b.text != blank or b.disclaimer != blank -%}
            <div class="before-after__body">
              {%- if b.title != blank -%}<h3>{{ b.title }}</h3>{%- endif -%}
              {%- if b.text != blank -%}<div class="rte">{{ b.text }}</div>{%- endif -%}
              {%- if b.disclaimer != blank -%}<small>{{ b.disclaimer }}</small>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
  </div>
</section>

