{%- liquid
  assign logo = settings.logo
  if section.settings.use_inverse_logo and settings.logo_inverse != blank
    assign logo = settings.logo_inverse
  endif
-%}

<footer
  class="footer color-{{ section.settings.color_scheme }} gradient"
  style="{% render 'section-style' %} --footer-columns: {{ section.settings.columns }}; --footer-border: {% if section.settings.border %}var(--border-width){% else %}0px{% endif %}; --footer-logo-width: {{ section.settings.logo_width }}px;"
>
  <div class="page-width footer__inner">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block{% if block.type == 'brand' %} footer__block--full{% endif %}" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                {%- if block.settings.show_logo -%}
                  <a href="{{ routes.root_url }}" class="footer__logo" aria-label="{{ shop.name | escape }}">
                    {%- if logo != blank -%}
                      {{ logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: shop.name }}
                    {%- else -%}
                      <span class="header__logo-text">{{ shop.name }}</span>
                    {%- endif -%}
                  </a>
                {%- endif -%}
                {%- if block.settings.tagline != blank -%}
                  <p class="footer__tagline">{{ block.settings.tagline }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.show_social -%}
                  {%- render 'social-links', style: block.settings.social_style -%}
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="footer__text rte">{{ block.settings.text }}</div>

              {%- when 'contact' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="footer__links" role="list">
                  {%- if block.settings.whatsapp != blank -%}
                    {%- assign wa_digits = block.settings.whatsapp | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
                    <li><a href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">WhatsApp: {{ block.settings.whatsapp }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <li><a href="tel:{{ block.settings.phone | remove: ' ' }}">{{ block.settings.phone }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <li><a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.hours != blank -%}
                    <li class="footer__text">{{ block.settings.hours }}</li>
                  {%- endif -%}
                </ul>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="footer__text rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- form 'customer', id: 'FooterNewsletter', class: 'footer__newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="form-message form-message--success" role="status">{{ 'sections.newsletter.success' | t }}</p>
                  {%- else -%}
                    <div class="footer__newsletter">
                      <label class="visually-hidden" for="FooterNewsletter-email">{{ 'sections.newsletter.email' | t }}</label>
                      <input id="FooterNewsletter-email" class="field__input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'sections.newsletter.email' | t }}">
                      <button type="submit" class="button button--small button--secondary">{{ 'sections.newsletter.button' | t }}</button>
                    </div>
                    {%- if form.errors -%}
                      <p class="form-message form-message--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                    {%- endif -%}
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name }}
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            &nbsp;·&nbsp;<a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </span>
      {%- if section.settings.bottom_text != blank -%}
        <b>{{ section.settings.bottom_text }}</b>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 8,
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "use_inverse_logo", "label": "Use logo for dark backgrounds", "default": true },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 40, "max": 300, "step": 4, "unit": "px", "default": 140 },
    {
      "type": "select", "id": "columns", "label": "Desktop column layout", "default": "1.6fr 1fr 1fr",
      "options": [
        { "value": "1.6fr 1fr 1fr", "label": "Wide brand + 2 columns" },
        { "value": "1.6fr 1fr 1fr 1fr", "label": "Wide brand + 3 columns" },
        { "value": "1fr 1fr 1fr", "label": "3 equal columns" },
        { "value": "1fr 1fr 1fr 1fr", "label": "4 equal columns" },
        { "value": "2fr 1fr", "label": "Brand + 1 column" }
      ]
    },
    { "type": "checkbox", "id": "border", "label": "Top border", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright name", "info": "Defaults to the store name" },
    { "type": "text", "id": "bottom_text", "label": "Bottom right text" },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": false },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": false },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 44 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_logo", "label": "Show logo", "default": true },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Calidad que llega a tu puerta." },
        { "type": "richtext", "id": "text", "label": "Description" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true, "info": "Set links in Theme settings > Social media" },
        {
          "type": "select", "id": "social_style", "label": "Social link style", "default": "pills",
          "options": [ { "value": "pills", "label": "Text pills" }, { "value": "icons", "label": "Icons" } ]
        }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Sobre nosotros" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Comparte información sobre tu tienda.</p>" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contacto" },
        { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "placeholder": "+52 55 0000 0000" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "text", "id": "hours", "label": "Service hours", "placeholder": "Lun–Vie 9:00–18:00" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Novedades" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ]
}
{% endschema %}
