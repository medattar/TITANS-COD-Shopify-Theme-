{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }} gradient" style="{% render 'section-style' %}">
  <div class="page-width">
    <header class="collection__header text-center">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="h1 collection__title">{{ blog.title | escape }}</h1>
      {%- if blog.all_tags.size > 0 and s.show_tags -%}
        <ul class="blog__tags" role="list">
          <li><a class="facets__pill{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">{{ 'blogs.general.all' | t }}</a></li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a class="facets__pill{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- paginate blog.articles by s.articles_per_page -%}
      <ul class="grid blog__grid" role="list" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ s.columns_desktop }};">
        {%- for article in blog.articles -%}
          <li>{%- render 'article-card', article: article, show_excerpt: s.show_excerpt, show_date: s.show_date, eager: forloop.first -%}</li>
        {%- else -%}
          <li class="collection__empty"><h2 class="h3">{{ 'blogs.general.empty' | t }}</h2></li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-main-blog",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
