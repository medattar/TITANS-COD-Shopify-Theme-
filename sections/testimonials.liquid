{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}
    {%- capture cards -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="testimonial-card testimonial-card--shadow" {{ block.shopify_attributes }}>
          {%- if b.avatar != blank -%}
            {{ b.avatar | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', class: 'testimonial-card__avatar', width: 64, height: 64, alt: b.name }}
          {%- endif -%}
          <div class="testimonial-card__body">
            {%- if b.rating > 0 -%}{%- render 'stars', rating: b.rating, scale: 5 -%}{%- endif -%}
            <blockquote class="testimonial-card__quote">{{ b.quote }}</blockquote>
            <div class="testimonial-card__author">
              <b class="testimonial-card__name">{{ b.name }}</b>
              {%- if b.role != blank -%}<span class="testimonial-card__role"> · {{ b.role }}</span>{%- endif -%}
              {%- if b.verified_label != blank -%}<span class="testimonial-card__verified">{%- render 'icon', icon: 'verified' -%}{{ b.verified_label }}</span>{%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if s.layout == 'carousel' -%}
      <slider-component class="slider slider--bleed" style="--slide-width: 86%; --slide-width-desktop: calc((100% - 44px) / 3); --slide-gap: 22px;">
        <div class="slider__track" data-slider-track>{{ cards }}</div>
        <div class="slider__nav">
          <button type="button" class="slider__button" data-slider-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
          <button type="button" class="slider__button" data-slider-next aria-label="{{ 'accessibility.next_slide' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
        </div>
      </slider-component>
    {%- else -%}
      <div class="grid" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ s.columns_desktop }};">{{ cards }}</div>
    {%- endif -%}
    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
  </div>
</section>

