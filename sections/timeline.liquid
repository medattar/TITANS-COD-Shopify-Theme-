{%- liquid
  assign show_here = true
  if section.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = section.settings.product | default: product
    assign show_ids = section.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}
    <ol class="timeline" role="list" style="--tl-cols: {{ section.blocks.size | at_most: 4 | at_least: 1 }};">
      {%- for block in section.blocks -%}
        <li class="timeline__step{% if s.reveal %} reveal{% endif %}" {{ block.shopify_attributes }}>
          <span class="timeline__dot" aria-hidden="true">{{ forloop.index }}</span>
          <div class="timeline__card lf-card">
            {%- if block.settings.label != blank -%}<span class="timeline__pill">{{ block.settings.label }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="timeline__title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="timeline__text rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="lf-cta-row"><a class="button" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="page-width"><div class="theme-placeholder">Hidden on this product. Change Show on to display this section here.</div></div>
{%- endif -%}

{% schema %}
{
