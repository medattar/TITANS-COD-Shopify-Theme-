{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign has_image = false
  if s.image != blank or s.image_mobile != blank
    assign has_image = true
  endif
  assign has_media = false
  if has_image or s.video != blank
    assign has_media = true
  endif
  assign placement = s.media_placement
  unless has_media
    assign placement = 'none'
  endunless
  assign loading = 'lazy'
  assign priority = 'auto'
  if section.index <= 3
    assign loading = 'eager'
    assign priority = 'high'
  endif
  assign hero_panel = ''
  if s.content_bg != blank and s.content_bg.alpha != 0
    assign hero_alpha = s.content_bg_opacity | default: 100 | divided_by: 100.0
    assign hero_panel = s.content_bg | color_modify: 'alpha', hero_alpha
  endif
-%}

<section
  class="hero section{% if s.inset %} hero--inset{% endif %} hero--{{ placement }} hero--align-{{ s.content_align }} hero--v-{{ s.content_vertical }}"
  style="{% render 'section-style' %} --hero-min-h: {{ s.min_height }}px; --hero-min-h-mobile: {{ s.min_height_mobile }}px; --hero-radius: {{ s.radius }}px; --hero-overlay: {{ s.overlay_opacity | divided_by: 100.0 }}; --hero-content-width: {{ s.content_width }}px; --hero-gap: {{ s.content_gap | default: 16 }}px; --hero-content-col: {{ s.content_col | default: 50 }}%;{% if s.content_opacity != blank and s.content_opacity < 100 %} --hero-content-opacity: {{ s.content_opacity | divided_by: 100.0 }};{% endif %}{% if s.pad_top > 0 %} --hero-pad-t: {{ s.pad_top }}px; --hero-pad-td: {{ s.pad_top }}px;{% endif %}{% if s.pad_right > 0 %} --hero-pad-r: {{ s.pad_right }}px; --hero-pad-rd: {{ s.pad_right }}px;{% endif %}{% if s.pad_bottom > 0 %} --hero-pad-b: {{ s.pad_bottom }}px; --hero-pad-bd: {{ s.pad_bottom }}px;{% endif %}{% if s.pad_left > 0 %} --hero-pad-l: {{ s.pad_left }}px; --hero-pad-ld: {{ s.pad_left }}px;{% endif %}{% if s.pad_top_mobile > 0 %} --hero-pad-t: {{ s.pad_top_mobile }}px;{% endif %}{% if s.pad_right_mobile > 0 %} --hero-pad-r: {{ s.pad_right_mobile }}px;{% endif %}{% if s.pad_bottom_mobile > 0 %} --hero-pad-b: {{ s.pad_bottom_mobile }}px;{% endif %}{% if s.pad_left_mobile > 0 %} --hero-pad-l: {{ s.pad_left_mobile }}px;{% endif %}{% if hero_panel != blank %} --hero-panel: {{ hero_panel }};{% endif %}{% if s.section_bg_gradient != blank %} --hero-canvas: {{ s.section_bg_gradient }};{% elsif s.section_bg != blank %} --hero-canvas: {{ s.section_bg }};{% endif %}"
  aria-label="{{ s.aria_label | default: shop.name | escape }}"
>
  <div class="{% if s.inset %}page-width{% endif %}">
    <div class="hero__card color-{{ s.color_scheme }} gradient{% if s.shadow %} hero__card--shadow{% endif %}">
      {%- if placement != 'none' -%}
        <div class="hero__media">
          {%- if s.video != blank -%}
            {{
              s.video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                playsinline: true,
                controls: false,
                preload: 'metadata',
                image_size: '1600x',
                class: 'hero__video'
            }}
          {%- else -%}
            {%- assign img_desktop = s.image | default: s.image_mobile -%}
            {%- assign img_mobile = s.image_mobile | default: s.image -%}
            {%- if placement == 'background' -%}
              {%- assign img_sizes = '100vw' -%}
            {%- else -%}
              {%- assign img_sizes = '(min-width: 990px) 50vw, 100vw' -%}
            {%- endif -%}
            <picture>
              {%- if s.image_mobile != blank and s.image != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ img_mobile | image_url: width: 600 }} 600w, {{ img_mobile | image_url: width: 900 }} 900w, {{ img_mobile | image_url: width: 1200 }} 1200w"
                  sizes="100vw"
                  width="{{ img_mobile.width }}"
                  height="{{ img_mobile.height }}"
                >
              {%- endif -%}
              {%- liquid
                assign focal = img_desktop.presentation.focal_point | default: 'center'
                assign img_style = 'object-position: ' | append: focal | append: ';'
              -%}
              {{
                img_desktop
                | image_url: width: 2400
                | image_tag:
                  widths: '600, 900, 1200, 1600, 2000, 2400',
                  sizes: img_sizes,
                  loading: loading,
                  fetchpriority: priority,
                  style: img_style,
                  alt: img_desktop.alt
              }}
            </picture>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hero__content">
        <div class="hero__content-inner">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}

              {%- when 'tag' -%}
                <p
                  class="hero__tag badge badge--{{ block.settings.style }}"
                  style="{% if block.settings.size > 0 %}font-size: {{ block.settings.size }}px;{% endif %}{% if block.settings.weight != blank and block.settings.weight != 'inherit' %}font-weight: {{ block.settings.weight }};{% endif %}{% if block.settings.letter != 0 %}letter-spacing: {{ block.settings.letter | divided_by: 100.0 }}em;{% endif %}{% if block.settings.radius > 0 %}border-radius: {{ block.settings.radius }}px;{% endif %}{% if block.settings.text_color != blank %}color: {{ block.settings.text_color }};{% endif %}{% if block.settings.bg_color != blank %}background: {{ block.settings.bg_color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'icon-or-image', icon: block.settings.icon, size: block.settings.icon_size, color: block.settings.icon_color -%}
                  {{- block.settings.text -}}
                </p>

              {%- when 'heading' -%}
                {%- liquid
                  assign tag = block.settings.tag
                  if tag == 'auto'
                    if section.index == 1
                      assign tag = 'h1'
                    else
                      assign tag = 'h2'
                    endif
                  endif
                  assign accent_paint = ''
                  if block.settings.accent_color != blank and block.settings.accent_color.alpha != 0
                    assign accent_paint = block.settings.accent_color
                  elsif block.settings.color != blank and block.settings.color.alpha != 0
                    assign accent_paint = block.settings.color
                  endif
                -%}
                <{{ tag }}
                  class="hero__heading font-{{ block.settings.font }}{% if block.settings.effect != 'none' %} fx-{{ block.settings.effect }}{% endif %}"
                  style="--size-d: {{ block.settings.size_desktop }}px; --size-m: {{ block.settings.size_mobile }}px;{% if block.settings.color != blank and block.settings.color.alpha != 0 %}color: {{ block.settings.color }};{% endif %}{% if accent_paint != blank %}--hero-accent: {{ accent_paint }};{% endif %}{% if block.settings.weight != blank and block.settings.weight != 'inherit' %}font-weight: {{ block.settings.weight }};{% endif %}{% if block.settings.letter != 0 %}letter-spacing: {{ block.settings.letter | divided_by: 100.0 }}em;{% endif %}{% if block.settings.line > 0 %}line-height: {{ block.settings.line | divided_by: 100.0 }};{% endif %}{% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}px;{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                  {%- if block.settings.accent_line != blank -%}
                    <span class="hero__accent-line"{% if accent_paint != blank %} style="color: {{ accent_paint }};"{% endif %}>{{ block.settings.accent_line }}</span>
                  {%- endif -%}
                </{{ tag }}>

              {%- when 'text' -%}
                <div class="hero__text rte" style="--size-d: {{ block.settings.size_desktop }}px; --size-m: {{ block.settings.size_mobile }}px;{% if block.settings.color != blank %}color: {{ block.settings.color }};{% endif %}{% if block.settings.weight != blank and block.settings.weight != 'inherit' %}font-weight: {{ block.settings.weight }};{% endif %}{% if block.settings.line > 0 %}line-height: {{ block.settings.line | divided_by: 100.0 }};{% endif %}{% if block.settings.max_width > 0 %}max-width: {{ block.settings.max_width }}px;{% endif %}{% if block.settings.letter != 0 %}letter-spacing: {{ block.settings.letter | divided_by: 100.0 }}em;{% endif %}" {{ block.shopify_attributes }}>
                  {{- block.settings.text -}}
                </div>

              {%- when 'countdown' -%}
                <div class="hero__countdown" {{ block.shopify_attributes }}>
                  {%- if block.settings.label != blank and block.settings.date != blank -%}
                    <p class="hero__countdown-label">{{ block.settings.label }}</p>
                  {%- endif -%}
                  {%- render 'countdown',
                    date: block.settings.date,
                    time: block.settings.time,
                    style: block.settings.style,
                    effect: block.settings.effect,
                    expired_text: block.settings.expired_text,
                    number_size: block.settings.number_size,
                    label_size: block.settings.label_size,
                    gap: block.settings.gap,
                    radius: block.settings.radius,
                    number_color: block.settings.number_color,
                    label_color: block.settings.label_color,
                    background: block.settings.background,
                    border_color: block.settings.border_color,
                    effect_speed: block.settings.effect_speed,
                    urgent_minutes: block.settings.urgent_minutes
                  -%}
                </div>

              {%- when 'buttons' -%}
                <div
                  class="buttons hero__buttons{% if block.settings.full_width %} hero__buttons--full{% endif %}"
                  style="{% if block.settings.font_size > 0 %}--hero-btn-size: {{ block.settings.font_size }}px;{% endif %}{% if block.settings.btn_radius > 0 %}--hero-btn-radius: {{ block.settings.btn_radius }}px;{% endif %}{% if block.settings.btn_min > 0 %}--hero-btn-min: {{ block.settings.btn_min }}px;{% endif %}{% if block.settings.btn_gap > 0 %}--hero-btn-gap: {{ block.settings.btn_gap }}px;{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.label_1 != blank -%}
                    <a
                      class="button button--{{ block.settings.style_1 }}{% if block.settings.large %} button--large{% endif %}"
                      {% if block.settings.link_1 != blank %}
                        href="{{ block.settings.link_1 }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                    >
                      {{- block.settings.label_1 -}}
                      {%- if block.settings.arrow -%}{%- render 'icon', icon: 'arrow-right' -%}{%- endif -%}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.label_2 != blank -%}
                    <a
                      class="button button--{{ block.settings.style_2 }}{% if block.settings.large %} button--large{% endif %}"
                      {% if block.settings.link_2 != blank %}
                        href="{{ block.settings.link_2 }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                    >
                      {{- block.settings.label_2 -}}
                    </a>
                  {%- endif -%}
                </div>

              {%- when 'trust' -%}
                <ul
                  class="hero__trust"
                  role="list"
                  style="--trust-size: {{ block.settings.text_size | default: 14 }}px; --trust-gap: {{ block.settings.gap | default: 8 }}px;{% if block.settings.text_color != blank %}--trust-color: {{ block.settings.text_color }};{% endif %}{% if block.settings.icon_color != blank %}--trust-icon: {{ block.settings.icon_color }};{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign key = 'item_' | append: i
                      assign icon_key = 'icon_' | append: i
                      assign color_key = 'color_' | append: i
                      assign item_icon = block.settings[icon_key]
                      if item_icon == blank or item_icon == 'inherit'
                        assign item_icon = block.settings.icon
                      endif
                      assign item_color = block.settings[color_key] | default: block.settings.icon_color
                    -%}
                    {%- if block.settings[key] != blank -%}
                      <li{% if item_color != blank and item_color.alpha != 0 %} style="--item-icon: {{ item_color }};"{% endif %}>
                        {%- render 'icon-or-image', icon: item_icon, size: block.settings.icon_size, color: item_color -%}
                        <span>{{ block.settings[key] }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>

              {%- when 'spacer' -%}
                <div style="height: {{ block.settings.height }}px;" aria-hidden="true" {{ block.shopify_attributes }}></div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "section-hero",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Page background behind the card",
      "info": "Separate from the card color scheme. Leave empty to keep the page color."
    },
    {
      "type": "color_background",
      "id": "section_bg_gradient",
      "label": "Page background gradient",
      "info": "Overrides the solid color when set."
    },
    {
      "type": "checkbox",
      "id": "inset",
      "label": "Inset card layout",
      "default": true,
      "info": "Off = full width"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Card shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Replaces images. Plays muted and looped."
    },
    {
      "type": "select",
      "id": "media_placement",
      "label": "Media placement",
      "default": "background",
      "options": [
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "split-right",
          "label": "Split, media right"
        },
        {
          "value": "split-left",
          "label": "Split, media left"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Background overlay",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Vertical position",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content max width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 820
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Space between text blocks",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "content_col",
      "label": "Content column width",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "Width of the text side on split heroes. The image takes the rest."
    },
    {
      "type": "range",
      "id": "content_opacity",
      "label": "Content opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "content_bg",
      "label": "Content panel background"
    },
    {
      "type": "range",
      "id": "content_bg_opacity",
      "label": "Content panel background opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Content spacing"
    },
    {
      "type": "paragraph",
      "content": "0 keeps the current spacing. Desktop values also apply on mobile until a mobile value is set."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Space above, desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_right",
      "label": "Space on the right, desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Space below, desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_left",
      "label": "Space on the left, desktop",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_top_mobile",
      "label": "Space above, mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_right_mobile",
      "label": "Space on the right, mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom_mobile",
      "label": "Space below, mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_left_mobile",
      "label": "Space on the left, mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height (desktop)",
      "min": 0,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 520
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Minimum height (mobile)",
      "min": 0,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 420
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible section name"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_inset",
      "label": "Side inset",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "box_radius_split",
      "label": "Different radius on each corner",
      "default": false,
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "range",
      "id": "box_radius_tl",
      "label": "Top left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_tr",
      "label": "Top right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_br",
      "label": "Bottom right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_bl",
      "label": "Bottom left radius",
