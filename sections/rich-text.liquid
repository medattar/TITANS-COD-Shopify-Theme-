{%- liquid
  assign show_here = true
  if section.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = section.settings.product | default: product
    assign show_ids = section.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{%- assign s = section.settings -%}
<section
  class="section color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width{% if s.narrow %} page-width--narrow{% endif %} rich-text text-{{ s.align }}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <p class="eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- when 'heading' -%}
          <h2 class="{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="rte rich-text__text{% if block.settings.small %} rich-text__text--small{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          {%- if block.settings.label != blank -%}
            <div class="buttons" {{ block.shopify_attributes }}>
              <a class="button button--{{ block.settings.style }}" href="{{ block.settings.link | default: '#buy' }}">{{ block.settings.label }}</a>
            </div>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{%- elsif request.design_mode -%}
  <div class="page-width"><div class="theme-placeholder">Hidden on this product. Change Show on to display this section here.</div></div>
{%- endif -%}

{% stylesheet %}
  .rich-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .rich-text.text-center {
    align-items: center;
  }

  .rich-text > * {
    margin: 0;
  }

  .rich-text__text--small {
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .rich-text.text-center .buttons {
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
    {"type": "select", "id": "show_on", "label": "Show on", "default": "all", "options": [{"value": "all", "label": "All products"}, {"value": "selected", "label": "Only the products below"}]},
    {"type": "product_list", "id": "show_products", "label": "Products", "limit": 50, "info": "Used when Show on is set to Only the products below."},
    {
