{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{% render 'color-scheme', source: s, key: 'color_scheme' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width faq faq--{{ s.layout }}">
    <div class="faq__intro">
      {%- render 'section-heading' -%}
      {%- if s.contact_label != blank and s.contact_link != blank -%}
        <a class="button button--outline" href="{{ s.contact_link }}">{{ s.contact_label }}</a>
      {%- endif -%}
    </div>
    <div class="accordion accordion--{{ s.style }}" data-accordion-exclusive>
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span class="accordion__title">{{ block.settings.question }}</span>
            <span class="accordion__toggle" aria-hidden="true">{%- render 'icon', icon: 'plus', class: 'accordion__icon-plus' -%}{%- render 'icon', icon: 'chevron-down', class: 'accordion__icon-chevron' -%}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if s.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

