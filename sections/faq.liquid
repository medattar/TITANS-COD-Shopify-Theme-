{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{{ s.color_scheme }} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width faq faq--{{ s.layout }}">
    <div class="faq__intro">
      {%- render 'section-heading' -%}
      {%- if s.contact_label != blank and s.contact_link != blank -%}
        <a class="button button--outline" href="{{ s.contact_link }}">{{ s.contact_label }}</a>
      {%- endif -%}
    </div>
    <div class="accordion accordion--{{ s.style }}" data-accordion-exclusive>
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">
            <span class="accordion__title">{{ block.settings.question }}</span>
            <span class="accordion__toggle" aria-hidden="true">{%- render 'icon', icon: 'plus', class: 'accordion__icon-plus' -%}{%- render 'icon', icon: 'chevron-down', class: 'accordion__icon-chevron' -%}</span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if s.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "tag": "div",
  "max_blocks": 30,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "faq" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ Preguntas ✦" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "lo que nos preguntan" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    {
      "type": "select", "id": "layout", "label": "Desktop layout", "default": "split",
      "options": [ { "value": "split", "label": "Heading beside questions" }, { "value": "stacked", "label": "Heading above questions" } ]
    },
    {
      "type": "select", "id": "style", "label": "Question style", "default": "cards",
      "options": [ { "value": "cards", "label": "Cards" }, { "value": "lines", "label": "Lines" } ]
    },
    { "type": "text", "id": "contact_label", "label": "Contact button label" },
    { "type": "url", "id": "contact_link", "label": "Contact button link" },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data for search engines", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "inline_richtext", "id": "question", "label": "Question", "default": "¿Pregunta frecuente?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Respuesta clara y honesta.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "¿Cómo funciona el pago contra entrega?", "answer": "<p>Haces tu pedido sin pagar en línea y pagas en efectivo al recibirlo.</p>" } },
        { "type": "question", "settings": { "question": "¿Cómo confirmo mi pedido?", "answer": "<p>Recibirás un mensaje por WhatsApp para confirmar tu pedido. Sin tu confirmación, tu pedido no será preparado ni enviado.</p>" } },
        { "type": "question", "settings": { "question": "¿Cuánto tarda el envío?", "answer": "<p>Escribe aquí tus tiempos reales de entrega.</p>" } },
        { "type": "question", "settings": { "question": "¿Puedo devolver mi producto?", "answer": "<p>Resume aquí tu política de devoluciones real.</p>" } }
      ]
    }
  ]
}
{% endschema %}
