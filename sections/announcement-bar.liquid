{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{%- liquid
  assign blocks_count = section.blocks.size
  assign mode = section.settings.mode
  if blocks_count < 2 and mode == 'rotate'
    assign mode = 'static'
  endif
-%}

{%- if blocks_count > 0 -%}
  <announcement-bar
    class="announcement-bar color-{% render 'color-scheme', source: section.settings, key: 'color_scheme' %} gradient{% if section.settings.hide_mobile %} hide-mobile{% endif %}"
    style="--announcement-height: {{ section.settings.height }}px; --announcement-size: {{ section.settings.text_size }}px; --announcement-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %}; --announcement-border: {% if section.settings.border %}var(--border-width){% else %}0{% endif %}; --marquee-speed: {{ section.settings.marquee_speed }}s;"
    data-speed="{{ section.settings.rotate_speed }}"
    {% if mode == 'marquee' %}
      data-marquee
    {% endif %}
    role="region"
    aria-label="{{ 'sections.announcement.label' | t }}"
  >
    <div class="announcement-bar__inner">
      {%- capture slides -%}
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__slide"
            data-announcement-slide
            {% if mode == 'rotate' and forloop.first == false %}
              aria-hidden="true"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- render 'icon-or-image', icon: block.settings.icon, size: 16 -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            <span>{{ block.settings.text }}</span>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- if block.settings.countdown_date != blank -%}
              <span data-countdown-wrapper>
                {%- render 'countdown', date: block.settings.countdown_date, time: block.settings.countdown_time, style: 'inline' -%}
              </span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="badge badge--highlight">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if mode == 'marquee' -%}
        <div class="marquee" style="width: 100%;">
          <div class="announcement-bar__marquee">
            {{ slides }}
            <div class="announcement-bar__clone" aria-hidden="true" style="display: contents;">{{ slides }}</div>
          </div>
        </div>
      {%- elsif mode == 'static' -%}
        <div class="announcement-bar__slides">{{ slides }}</div>
      {%- else -%}
        <div class="announcement-bar__slides" aria-live="polite">{{ slides }}</div>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 8,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "scheme_source",
      "label": "Color scheme",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme color scheme"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "info": "Theme color scheme follows Theme settings > Colors. Custom keeps a scheme on this section only."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Custom color scheme",
      "default": "scheme-4",
      "visible_if": "{{ section.settings.scheme_source == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Display",
      "default": "rotate",
      "options": [
        {
          "value": "rotate",
          "label": "Rotate messages"
        },
        {
          "value": "marquee",
          "label": "Scrolling ticker"
        },
        {
          "value": "static",
          "label": "Show first message only"
        }
      ]
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "label": "Rotation interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Ticker duration",
      "min": 10,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 30
    },
    {
      "type": "range",
      "id": "height",
      "label": "Minimum height",
      "min": 28,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 0.5,
      "unit": "px",
      "default": 12.5
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "Bottom border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_inset",
      "label": "Side inset",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_border_style",
      "label": "Border style",
      "default": "solid",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Border color",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Background color",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "color_background",
      "id": "box_bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_shadow",
      "label": "Shadow",
      "default": "none",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "hard",
          "label": "Hard (offset)"
        },
        {
          "value": "glow",
          "label": "Glow"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_shadow_color",
      "label": "Shadow color",
      "default": "#000000",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_effect",
      "label": "Hover effect",
      "default": "none",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "grow",
          "label": "Grow"
        },
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "dim",
          "label": "Dim"
        }
      ]
    },
    {
      "type": "range",
      "id": "box_max_width",
      "label": "Max width (0 = full)",
      "min": 0,
      "max": 1600,
      "step": 20,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_align",
      "label": "Position when narrower",
      "default": "center",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "checkbox",
      "id": "tx_enable",
      "label": "Customize fonts and spacing",
      "default": false
    },
    {
      "type": "select",
      "id": "tx_font",
      "label": "Font",
      "default": "inherit",
      "visible_if": "{{ section.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "display",
          "label": "Display"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        }
      ]
    },
    {
      "type": "select",
      "id": "tx_weight",
      "label": "Weight",
      "default": "inherit",
      "visible_if": "{{ section.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "tx_size",
      "label": "Font size, desktop (0 = default)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_size_m",
      "label": "Font size, mobile (0 = default)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_letter",
      "label": "Letter spacing (1/100 em)",
      "min": -10,
      "max": 40,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_word",
      "label": "Word spacing (1/100 em)",
      "min": -20,
      "max": 100,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_line",
      "label": "Line height (10 = 1.0, 0 = default)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.tx_enable }}"
    },
    {
      "type": "select",
      "id": "tx_transform",
      "label": "Letter case",
      "default": "inherit",
      "visible_if": "{{ section.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "select",
      "id": "tx_align",
      "label": "Alignment",
      "default": "inherit",
      "visible_if": "{{ section.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "tx_color",
      "label": "Text color",
      "visible_if": "{{ section.settings.tx_enable }}"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Pago contra entrega · Envío a todo México"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "cash",
              "label": "Cash"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "clock",
              "label": "Clock"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "whatsapp",
              "label": "WhatsApp"
            },
            {
              "value": "percent",
              "label": "Percent"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ]
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text",
          "info": "Shown as a pill after the message"
        },
        {
          "type": "header",
          "content": "Countdown"
        },
        {
          "type": "text",
          "id": "countdown_date",
          "label": "End date",
          "placeholder": "2026-12-31",
          "info": "Format YYYY-MM-DD. Leave empty to hide. Hidden automatically after it ends."
        },
        {
          "type": "text",
          "id": "countdown_time",
          "label": "End time",
          "placeholder": "23:59",
          "info": "24h format, store visitor's local time"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}
{% endschema %}
