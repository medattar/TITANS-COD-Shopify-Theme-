{%- liquid
  assign blocks_count = section.blocks.size
  assign mode = section.settings.mode
  if blocks_count < 2 and mode == 'rotate'
    assign mode = 'static'
  endif
-%}

{%- if blocks_count > 0 -%}
  <announcement-bar
    class="announcement-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.hide_mobile %} hide-mobile{% endif %}"
    style="--announcement-height: {{ section.settings.height }}px; --announcement-size: {{ section.settings.text_size }}px; --announcement-transform: {% if section.settings.uppercase %}uppercase{% else %}none{% endif %}; --announcement-border: {% if section.settings.border %}var(--border-width){% else %}0{% endif %}; --marquee-speed: {{ section.settings.marquee_speed }}s;"
    data-speed="{{ section.settings.rotate_speed }}"
    {% if mode == 'marquee' %}
      data-marquee
    {% endif %}
    role="region"
    aria-label="{{ 'sections.announcement.label' | t }}"
  >
    <div class="announcement-bar__inner">
      {%- capture slides -%}
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__slide"
            data-announcement-slide
            {% if mode == 'rotate' and forloop.first == false %}
              aria-hidden="true"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- render 'icon-or-image', icon: block.settings.icon, size: 16 -%}
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            <span>{{ block.settings.text }}</span>
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- if block.settings.countdown_date != blank -%}
              <span data-countdown-wrapper>
                {%- render 'countdown', date: block.settings.countdown_date, time: block.settings.countdown_time, style: 'inline' -%}
              </span>
            {%- endif -%}
            {%- if block.settings.badge != blank -%}
              <span class="badge badge--highlight">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endcapture -%}

      {%- if mode == 'marquee' -%}
        <div class="marquee" style="width: 100%;">
          <div class="announcement-bar__marquee">
            {{ slides }}
            <div class="announcement-bar__clone" aria-hidden="true" style="display: contents;">{{ slides }}</div>
          </div>
        </div>
      {%- elsif mode == 'static' -%}
        <div class="announcement-bar__slides">{{ slides }}</div>
      {%- else -%}
        <div class="announcement-bar__slides" aria-live="polite">{{ slides }}</div>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 8,
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" },
    {
      "type": "select", "id": "mode", "label": "Display", "default": "rotate",
      "options": [
        { "value": "rotate", "label": "Rotate messages" },
        { "value": "marquee", "label": "Scrolling ticker" },
        { "value": "static", "label": "Show first message only" }
      ]
    },
    { "type": "range", "id": "rotate_speed", "label": "Rotation interval", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "marquee_speed", "label": "Ticker duration", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 30 },
    { "type": "range", "id": "height", "label": "Minimum height", "min": 28, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "text_size", "label": "Text size", "min": 10, "max": 18, "step": 0.5, "unit": "px", "default": 12.5 },
    { "type": "checkbox", "id": "uppercase", "label": "Uppercase", "default": true },
    { "type": "checkbox", "id": "border", "label": "Bottom border", "default": false },
    { "type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Pago contra entrega · Envío a todo México" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "none",
          "options": [
            { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "cash", "label": "Cash" },
            { "value": "shield", "label": "Shield" }, { "value": "gift", "label": "Gift" }, { "value": "clock", "label": "Clock" },
            { "value": "sparkle", "label": "Sparkle" }, { "value": "whatsapp", "label": "WhatsApp" }, { "value": "percent", "label": "Percent" },
            { "value": "star", "label": "Star" }, { "value": "heart", "label": "Heart" }
          ]
        },
        { "type": "text", "id": "badge", "label": "Badge text", "info": "Shown as a pill after the message" },
        { "type": "header", "content": "Countdown" },
        { "type": "text", "id": "countdown_date", "label": "End date", "placeholder": "2026-12-31", "info": "Format YYYY-MM-DD. Leave empty to hide. Hidden automatically after it ends." },
        { "type": "text", "id": "countdown_time", "label": "End time", "placeholder": "23:59", "info": "24h format, store visitor's local time" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [ { "type": "announcement" } ]
    }
  ]
}
{% endschema %}
