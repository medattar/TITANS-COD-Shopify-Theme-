{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings
  assign fp = s.product
  assign form_id = 'product-form-' | append: section.id
-%}

{%- if fp == blank -%}
  <div class="section color-{% render 'scheme', s: s, area: 'product' %} gradient" style="{% render 'section-style' %}">
    <div class="page-width">
      <div class="featured-product__empty">
        <div class="media ratio-portrait">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        <div>
          <h2 class="h2">{{ 'sections.featured_product.placeholder_title' | t }}</h2>
          <p>{{ 'sections.featured_product.placeholder_text' | t }}</p>
        </div>
      </div>
    </div>
  </div>
{%- else -%}
  {%- liquid
    assign current_variant = fp.selected_or_first_available_variant
  -%}
  {%- capture blocks_html -%}{% content_for 'blocks' %}{%- endcapture -%}
  {%- liquid
    assign has_buy_buttons = false
    if blocks_html contains 'data-purchase-mode='
      assign has_buy_buttons = true
    endif
  -%}
  <product-info
    id="FeaturedProduct-{{ section.id }}"
    class="section main-product featured-product color-{% render 'scheme', s: s, area: 'product' %} gradient"
    style="{% render 'section-style' %} --product-cols: {{ s.columns }}; --product-gap: {{ s.column_gap }}px; --thumb-rail: {{ s.thumb_rail_width }}%; --media-radius: {{ s.media_radius }}px;"
    data-section-id="{{ section.id }}"
    data-product-id="{{ fp.id }}"
    data-product-url="{{ fp.url }}"
    data-render-url="{{ fp.url }}"
    data-form-id="{{ form_id }}"
    data-update-url="false"
  >
    <div class="page-width"{% if s.anchor != blank %} id="{{ s.anchor | handle }}"{% endif %}>
      <div class="product featured-product__grid product--thumbs-{{ s.gallery_layout }}{% if s.media_position == 'right' %} product--media-right{% endif %}">
        <div class="product__gallery">
          {%- render 'product-media-gallery', product: fp, section: section, priority: false -%}
        </div>
        <div class="product__buy">
          {%- unless has_buy_buttons -%}
            {%- form 'product', fp, id: form_id, class: 'product-form product-form--fallback', novalidate: 'novalidate' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
            {%- endform -%}
          {%- endunless -%}
          {{ blocks_html }}
        </div>
      </div>
    </div>

    <script type="application/json" data-product-json>
      {
        "id": {{ fp.id }},
        "url": {{ fp.url | json }},
        "options": {{ fp.options | json }},
        "variants": [
          {%- for variant in fp.variants -%}
            {
              "id": {{ variant.id }},
              "options": {{ variant.options | json }},
              "available": {{ variant.available | json }},
              "featured_media_id": {{ variant.featured_media.id | default: 'null' }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  </product-info>
{%- endif -%}


{% stylesheet %}
  .featured-product__empty {
    display: grid;
    gap: 24px;
    align-items: center;
  }

  .featured-product__grid {
    grid-template-areas: 'gal' 'buy';
  }

  @media (min-width: 990px) {
    .featured-product__empty {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
    }

    .featured-product__grid {
      grid-template-rows: auto;
      grid-template-areas: 'gal buy';
      align-items: start;
    }

    .featured-product__grid.product--media-right {
      grid-template-areas: 'buy gal';
    }
  }
{% endstylesheet %}

