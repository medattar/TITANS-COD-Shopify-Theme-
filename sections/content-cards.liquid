{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign card_vw = 100 | divided_by: s.columns_desktop
  assign card_sizes = '(min-width: 990px) ' | append: card_vw | append: 'vw, 85vw'
-%}
<section
  class="section lf-section color-{{ s.color_scheme }} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}

    {%- capture cards -%}
      {%- for block in section.blocks -%}
        <article class="content-card lf-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="media content-card__media" style="--ratio: {{ s.image_ratio }};">
              {%- render 'image', image: block.settings.image, sizes: card_sizes -%}
            </div>
          {%- endif -%}
          <div class="content-card__body">
            {%- if block.settings.pill != blank -%}<span class="badge badge--highlight">{{ block.settings.pill }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="content-card__title">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.text != blank -%}<div class="content-card__text rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.source != blank -%}<small class="content-card__source">{{ block.settings.source }}</small>{%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="link content-card__link" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if s.layout == 'carousel' -%}
      <slider-component class="slider slider--bleed content-cards" style="--slide-width: 82%; --slide-width-desktop: calc((100% - 22px * {{ s.columns_desktop | minus: 1 }}) / {{ s.columns_desktop }}); --slide-gap: 22px;">
        <div class="slider__track" data-slider-track>{{ cards }}</div>
        <div class="slider__nav">
          <button type="button" class="slider__button" data-slider-prev aria-label="{{ 'accessibility.previous_slide' | t }}">{%- render 'icon', icon: 'chevron-left' -%}</button>
          <button type="button" class="slider__button" data-slider-next aria-label="{{ 'accessibility.next_slide' | t }}">{%- render 'icon', icon: 'chevron-right' -%}</button>
        </div>
      </slider-component>
    {%- else -%}
      <div class="grid content-cards" style="--cols-mobile: 1; --cols-tablet: 2; --cols-desktop: {{ s.columns_desktop }};">{{ cards }}</div>
    {%- endif -%}

    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="lf-cta-row"><a class="button" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Content cards",
  "class": "section-content-cards",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "✦ 01 · La ciencia ✦" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "lo que dicen los estudios" },
    { "type": "richtext", "id": "subheading", "label": "Subheading" },
    {
      "type": "select", "id": "heading_align", "label": "Heading alignment", "default": "center",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "carousel",
      "options": [ { "value": "carousel", "label": "Carousel" }, { "value": "grid", "label": "Grid" } ]
    },
    { "type": "range", "id": "columns_desktop", "label": "Cards per row (desktop)", "min": 2, "max": 4, "step": 1, "default": 3 },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4 / 3",
      "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 3", "label": "Landscape" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "16 / 9", "label": "Wide" } ]
    },
    { "type": "richtext", "id": "note", "label": "Note below cards", "info": "Use for sources and disclaimers" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "#buy" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "pill", "label": "Tag", "default": "Categoría" },
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Un beneficio claro." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Explica el beneficio con información verificable.</p>" },
        { "type": "text", "id": "source", "label": "Source / footnote" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Content cards", "blocks": [ { "type": "card" }, { "type": "card" }, { "type": "card" } ] }
  ]
}
{% endschema %}
