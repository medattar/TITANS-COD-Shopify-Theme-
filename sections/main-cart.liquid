{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
{%- liquid
  assign show_checkout_button = true
  if settings.show_drawer_checkout == false
    assign show_checkout_button = false
  endif
  assign cart_shadow = ''
  case s.card_shadow
    when 'none'
      assign cart_shadow = 'none'
    when 'soft'
      assign cart_shadow_color = s.card_shadow_color | color_modify: 'alpha', 0.16
      assign cart_shadow = '0 10px 30px ' | append: cart_shadow_color
    when 'medium'
      assign cart_shadow_color = s.card_shadow_color | color_modify: 'alpha', 0.24
      assign cart_shadow = '0 16px 40px ' | append: cart_shadow_color
    when 'hard'
      assign cart_shadow = '5px 5px 0 ' | append: s.card_shadow_color
    when 'glow'
      assign cart_shadow_color = s.card_shadow_color | color_modify: 'alpha', 0.45
      assign cart_shadow = '0 0 26px ' | append: cart_shadow_color
  endcase
-%}
<section
  class="section cart-page color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}{% if s.card_radius > 0 %}--cart-radius: {{ s.card_radius }}px;{% endif %}{% if s.card_bg != blank and s.card_bg.alpha != 0 %}--cart-card-bg: {{ s.card_bg }};{% endif %}{% if s.card_text != blank and s.card_text.alpha != 0 %}--cart-card-text: {{ s.card_text }};{% endif %}{% if s.card_border != blank and s.card_border.alpha != 0 %}--cart-border: {{ s.card_border }};{% endif %}{% if s.card_border_width > 0 %}--cart-border-width: {{ s.card_border_width }}px;{% endif %}{% if cart_shadow != blank %}--cart-shadow: {{ cart_shadow }};{% endif %}{% if s.card_gap > 0 %}--cart-gap: {{ s.card_gap }}px;{% endif %}{% if s.image_radius > 0 %}--cart-image-radius: {{ s.image_radius }}px;{% endif %}{% if s.title_color != blank and s.title_color.alpha != 0 %}--cart-title: {{ s.title_color }};{% endif %}{% if s.price_color != blank and s.price_color.alpha != 0 %}--cart-price: {{ s.price_color }};{% endif %}{% if s.muted_color != blank and s.muted_color.alpha != 0 %}--cart-muted: {{ s.muted_color }};{% endif %}{% if s.taxes_color != blank and s.taxes_color.alpha != 0 %}--cart-taxes-color: {{ s.taxes_color }};{% endif %}{% if s.taxes_size > 0 %}--cart-taxes-size: {{ s.taxes_size }}px;{% endif %}{% if s.taxes_align == 'center' or s.taxes_align == 'right' %}--cart-taxes-align: {{ s.taxes_align }};{% endif %}"
>
  <div class="page-width">
    <h1 class="h1 cart-page__title">{{ 'cart.general.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <div class="cart-page__grid" data-cart-has-items>
        <cart-items class="cart-page__lines lf-card" data-section-id="{{ section.id }}">
          <div class="cart-errors form-message--error" data-cart-errors role="alert"></div>
          {%- render 'cart-line-items' -%}
        </cart-items>
        <aside class="cart-page__summary lf-card" aria-label="{{ 'cart.general.summary' | t }}">
          <div class="cart-page__totals" data-cart-refresh="totals">
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="cart-item__discounts" role="list">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li>{{ discount.title }} (−{% render 'format-money', amount: discount.total_allocated_amount %})</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <div class="cart-totals">
              <span>{{ 'cart.general.subtotal' | t }}</span>
              <span class="cart-totals__value">{% render 'format-money', amount: cart.total_price %}</span>
            </div>
          </div>
          {%- if s.show_taxes != false -%}
            <p class="cart-taxes">
              {%- if s.taxes_text != blank -%}
                {{ s.taxes_text | escape }}
              {%- else -%}
                {{ 'cart.general.taxes_shipping_at_checkout' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}
          <form action="{{ routes.cart_url }}" method="post" id="CartPage-Form">
            {%- if settings.cart_note -%}
              <div class="field cart-note">
                <label class="field__label" for="CartPage-Note">{{ 'cart.general.note' | t }}</label>
                <textarea id="CartPage-Note" class="field__input" name="note" rows="3">{{ cart.note }}</textarea>
              </div>
            {%- endif -%}
            <button type="submit" name="checkout" class="button button--full button--large"{% unless show_checkout_button %} hidden{% endunless %}>{{ 'cart.general.checkout' | t }}</button>
          </form>
          {%- if additional_checkout_buttons and s.show_dynamic_checkout -%}
            <div class="cart-page__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
          {%- if settings.cart_trust_text != blank -%}
            <p class="cart-trust">{{ settings.cart_trust_text }}</p>
          {%- endif -%}
          {%- if s.cod_note != blank -%}
            <div class="cart-page__cod rte">{{ s.cod_note }}</div>
          {%- endif -%}
        </aside>
      </div>
    {%- else -%}
      <cart-items class="cart-page__items" data-section-id="{{ section.id }}">
        <div class="collection__empty">
          <h2 class="h3">{{ 'cart.general.empty' | t }}</h2>
          <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.general.continue_shopping' | t }}</a>
        </div>
      </cart-items>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
