{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section
  class="section lf-section color-{{ s.color_scheme }} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    {%- render 'section-heading' -%}
    <ol class="steps" role="list" style="--steps-cols: {{ s.columns_desktop }};">
      {%- for block in section.blocks -%}
        <li class="step lf-card{% unless block.settings.image != blank %} step--no-image{% endunless %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="step__media media" style="--ratio: {{ s.image_ratio }};">
              {%- render 'image', image: block.settings.image, sizes: '(min-width: 990px) 33vw, 104px' -%}
            </div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="step__icon">{%- render 'icon', icon: block.settings.icon -%}</span>
          {%- endif -%}
          <div class="step__body">
            <h3 class="step__title">
              {%- if s.show_numbers -%}<span class="step__number">{{ forloop.index }}</span>{%- endif -%}
              {{ block.settings.title }}
            </h3>
            {%- if block.settings.text != blank -%}<div class="step__text rte">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if s.note != blank -%}<div class="lf-note rte">{{ s.note }}</div>{%- endif -%}
    {%- if s.button_label != blank -%}
      <div class="lf-cta-row"><a class="button" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label }}</a></div>
    {%- endif -%}
  </div>
</section>

