{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section color-{{ s.color_scheme }} gradient" style="{% render 'section-style' %}">
  <div class="page-width">
    <header class="collection__header text-center">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="h1 collection__title">{{ s.heading | default: page_title }}</h1>
    </header>
    {%- paginate collections by 24 -%}
      <ul class="grid collection-list" role="list" style="--cols-mobile: {{ s.columns_mobile }}; --cols-tablet: 3; --cols-desktop: {{ s.columns_desktop }};">
        {%- for collection in collections -%}
          <li>
            <a class="collection-tile lf-card" href="{{ collection.url }}">
              <div class="media" style="--ratio: {{ s.image_ratio }};">
                {%- assign tile_image = collection.featured_image | default: collection.products.first.featured_image -%}
                {%- if tile_image -%}
                  {%- render 'image', image: tile_image, sizes: '(min-width: 990px) 25vw, 50vw' -%}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <span class="collection-tile__title">
                {{ collection.title | escape }}
                {%- render 'icon', icon: 'arrow-right' -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "tag": "div",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Colecciones" },
    {
      "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1 / 1",
      "options": [ { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "4 / 3", "label": "Landscape" } ]
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ]
}
{% endschema %}
