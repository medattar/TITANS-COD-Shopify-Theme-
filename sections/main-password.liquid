{%- assign s = section.settings -%}
<section class="password color-{% render 'color-scheme', source: s, key: 'color_scheme' %} gradient">
  <div class="password__card lf-card">
    {%- if settings.logo -%}
      {{ settings.logo | image_url: width: 400 | image_tag: class: 'password__logo', width: 180, alt: shop.name }}
    {%- else -%}
      <p class="h2 password__shop">{{ shop.name }}</p>
    {%- endif -%}
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
    <h1 class="h2">{{ s.heading | default: shop.password_message }}</h1>
    {%- if shop.password_message != blank and s.heading != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}

    {%- if s.show_newsletter -%}
      {%- form 'customer', class: 'password__form' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <div class="search-page__form">
            <label class="visually-hidden" for="PasswordNewsletter">{{ 'general.newsletter.email' | t }}</label>
            <input id="PasswordNewsletter" class="field__input" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'general.newsletter.email' | t }}">
            <button type="submit" class="button">{{ 'general.newsletter.subscribe' | t }}</button>
          </div>
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="password__login">
      <summary class="link">{{ 'general.password_page.login' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="search-page__form">
          <label class="visually-hidden" for="StorePassword">{{ 'general.password_page.password' | t }}</label>
          <input id="StorePassword" class="field__input" type="password" name="password" autocomplete="current-password" required placeholder="{{ 'general.password_page.password' | t }}">
          <button type="submit" class="button">{{ 'general.password_page.enter' | t }}</button>
        </div>
      {%- endform -%}
    </details>
    <small class="password__admin">{{ 'general.password_page.admin_link_html' | t }}</small>
  </div>
</section>

{% stylesheet %}
  .password {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100svh;
    padding: 24px var(--page-margin-mobile);
  }

  .password__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
    max-width: 560px;
    padding: 36px 24px;
    text-align: center;
  }

  .password__card .h2 {
    margin: 0;
  }

  .password__logo {
    height: auto;
    max-width: 180px;
  }

  .password__form,
  .password__login {
    width: 100%;
  }

  .password__login summary {
    cursor: pointer;
    list-style: none;
  }

  .password__login[open] summary {
    margin-bottom: 12px;
  }

  .password__admin {
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "class": "section-main-password",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "scheme_source",
      "label": "Color scheme",
      "default": "theme",
      "options": [
        {
          "value": "theme",
          "label": "Theme color scheme"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "info": "Theme color scheme follows Theme settings > Colors. Custom keeps a scheme on this section only."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Custom color scheme",
      "default": "scheme-4",
      "visible_if": "{{ section.settings.scheme_source == 'custom' }}"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Muy pronto ✦"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Estamos preparando algo especial"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show email signup",
      "default": true
    }
  ]
}
{% endschema %}
