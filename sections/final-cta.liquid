{%- liquid
  assign show_here = true
  if section.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = section.settings.product | default: product
    assign show_ids = section.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign items = s.list | newline_to_br | split: '<br />'
-%}
<section
  class="section lf-section color-{% render 'scheme', s: s, area: 'sections' %} gradient"
  style="{% render 'section-style' %}"
  {% if s.anchor != blank %}
    id="{{ s.anchor | handle }}"
  {% endif %}
>
  <div class="page-width">
    <div class="final-cta lf-card color-{{ s.card_scheme }}{% if s.image == blank %} final-cta--no-image{% endif %}">
      {%- if s.image != blank -%}
        <div class="final-cta__media media">
          {%- render 'image', image: s.image, sizes: '(min-width: 990px) 500px, 100vw' -%}
        </div>
      {%- endif -%}
      <div class="final-cta__content">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.list != blank -%}
          <ul class="final-cta__list" role="list">
            {%- for item in items -%}
              {%- assign item_text = item | strip -%}
              {%- if item_text != blank -%}<li>{%- render 'icon', icon: 'check' -%}<span>{{ item_text }}</span></li>{%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="button button--large" href="{{ s.button_link | default: '#buy' }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if s.disclaimer != blank -%}<div class="lf-note lf-note--small rte">{{ s.disclaimer }}</div>{%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}
  <div class="page-width"><div class="theme-placeholder">Hidden on this product. Change Show on to display this section here.</div></div>
{%- endif -%}

{% schema %}
{
