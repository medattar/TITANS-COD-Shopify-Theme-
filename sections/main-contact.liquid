{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-pages.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="section color-{% render 'scheme', s: s, area: 'sections' %} gradient" style="{% render 'section-style' %}">
  <div class="page-width contact">
    <div class="contact__intro">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1 class="h1">{{ s.heading | default: page.title }}</h1>
      {%- if page.content != blank -%}<div class="rte lead">{{ page.content }}</div>{%- endif -%}
      {%- assign wa_link = s.whatsapp_link | default: settings.social_whatsapp_link -%}
      {%- if wa_link != blank -%}
        <a class="button button--outline contact__whatsapp" href="{{ wa_link }}" target="_blank" rel="noopener">
          {%- render 'icon', icon: 'whatsapp' -%}
          <span>{{ 'templates.contact.whatsapp' | t }}</span>
        </a>
      {%- endif -%}
    </div>

    <div class="contact__form lf-card">
      {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>{%- render 'icon', icon: 'check-circle' -%} {{ 'templates.contact.success' | t }}</p>
        {%- elsif form.errors -%}
          <div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="contact-form__row">
          <div class="field">
            <label class="field__label" for="ContactForm-name">{{ 'templates.contact.name' | t }}</label>
            <input class="field__input" id="ContactForm-name" type="text" name="contact[{{ 'templates.contact.name' | t }}]" autocomplete="name" value="{{ form.name }}">
          </div>
          <div class="field">
            <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.phone' | t }}</label>
            <input class="field__input" id="ContactForm-phone" type="tel" name="contact[{{ 'templates.contact.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-email">{{ 'templates.contact.email' | t }} <span aria-hidden="true">*</span></label>
          <input class="field__input" id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required aria-required="true" value="{{ form.email }}"{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-order">{{ 'templates.contact.order' | t }}</label>
          <input class="field__input" id="ContactForm-order" type="text" name="contact[{{ 'templates.contact.order' | t }}]">
        </div>
        <div class="field">
          <label class="field__label" for="ContactForm-body">{{ 'templates.contact.message' | t }}</label>
          <textarea class="field__input" id="ContactForm-body" name="contact[body]" rows="5">{{ form.body }}</textarea>
        </div>
        <button type="submit" class="button button--full">{{ 'templates.contact.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-main-contact",
  "tag": "div",
  "settings": [
