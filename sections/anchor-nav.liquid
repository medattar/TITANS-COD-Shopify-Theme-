    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Stick below the header while scrolling",
      "default": true
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible name",
      "default": "En esta página"
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
