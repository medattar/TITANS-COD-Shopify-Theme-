{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{{ 'section-longform.css' | asset_url | stylesheet_tag }}

<anchor-nav
  class="anchor-nav color-{% render 'color-scheme', source: section.settings, key: 'color_scheme' %} gradient{% if section.settings.sticky %} anchor-nav--sticky{% endif %}"
  aria-label="{{ section.settings.aria_label | escape }}"
  role="navigation"
>
  <div class="anchor-nav__inner page-width">
    {%- for block in section.blocks -%}
      {%- assign anchor = block.settings.anchor | remove: '#' | handle -%}
      {%- if anchor != blank and block.settings.label != blank -%}
        <a href="#{{ anchor }}" data-anchor-link {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</anchor-nav>

{% schema %}
{
  "name": "Anchor navigation",
  "class": "section-anchor-nav",
  "tag": "div",
  "max_blocks": 10,
  "settings": [
