{%- capture box_sel -%}#shopify-section-{{ section.id }} > :not(style, link, script, template){%- endcapture -%}
{%- render 'box-style', bs: section.settings, sel: box_sel -%}
{%- liquid
  assign logo = settings.logo
  if section.settings.use_inverse_logo and settings.logo_inverse != blank
    assign logo = settings.logo_inverse
  endif
  assign menu_drawer_id = 'MenuDrawer-' | append: section.id
  assign search_id = 'SearchModal-' | append: section.id
  assign logo_tag = 'div'
  if request.page_type == 'index'
    assign logo_tag = 'h1'
  endif
-%}

{%- capture menu_style -%}
  --header-height-mobile: {{ section.settings.height_mobile }}px;
  --header-height-desktop: {{ section.settings.height_desktop }}px;
  --header-border: {% if section.settings.border %}var(--border-width){% else %}0px{% endif %};
  --menu-size: {{ section.settings.menu_size }}px;
  --menu-letter-spacing: {{ section.settings.menu_letter_spacing | divided_by: 100.0 }}em;
  --menu-transform: {% if section.settings.menu_uppercase %}uppercase{% else %}none{% endif %};
  --menu-gap: {{ section.settings.menu_gap }}px;
  --header-icon-size: {{ section.settings.icon_size }}px;
{%- endcapture -%}

{%- capture icon_menu -%}{% render 'icon-or-image', icon: 'menu', image: section.settings.menu_icon_image %}{%- endcapture -%}
{%- capture icon_search -%}{% render 'icon-or-image', icon: 'search', image: section.settings.search_icon_image %}{%- endcapture -%}
{%- capture icon_account -%}{% render 'icon-or-image', icon: 'account', image: section.settings.account_icon_image %}{%- endcapture -%}
{%- capture icon_cart -%}{% render 'icon-or-image', icon: section.settings.cart_icon, image: section.settings.cart_icon_image %}{%- endcapture -%}

{%- capture menu_toggle -%}
  <button
    type="button"
    class="header__icon header__menu-toggle{% if section.settings.menu_toggle_desktop == false %} header__menu-toggle--mobile-only{% endif %}"
    data-open-dialog="{{ menu_drawer_id }}"
    aria-controls="{{ menu_drawer_id }}"
    aria-expanded="false"
    aria-label="{{ 'sections.header.menu' | t }}"
  >
    {{- icon_menu -}}
  </button>
{%- endcapture -%}

{%- capture icons_end -%}
  {%- if section.settings.show_search -%}
    <button type="button" class="header__icon" data-open-dialog="{{ search_id }}" aria-label="{{ 'sections.header.search' | t }}">
      {{- icon_search -}}
    </button>
  {%- endif -%}
  {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
    <a href="{{ routes.account_url }}" class="header__icon hide-mobile" aria-label="{{ 'sections.header.account' | t }}">
      {{- icon_account -}}
    </a>
  {%- endif -%}
  {%- if section.settings.show_cart != false -%}
    <a
      href="{{ routes.cart_url }}"
      class="header__icon"
      {% if settings.cart_type == 'drawer' %}
        data-open-dialog="CartDrawer" aria-controls="CartDrawer" aria-expanded="false" role="button"
      {% endif %}
      aria-label="{{ 'sections.header.cart' | t }}"
    >
      {{- icon_cart -}}
      <span class="cart-count" data-cart-count data-count="{{ cart.item_count }}">{% if cart.item_count > 0 %}{{ cart.item_count }}{% endif %}</span>
    </a>
  {%- endif -%}
{%- endcapture -%}

<sticky-header
  class="header-wrapper{% if section.settings.sticky != 'none' %} header-wrapper--sticky{% endif %}{% if section.settings.sticky == 'scroll-up' %} header-wrapper--sticky-scroll{% endif %}"
  data-sticky="{{ section.settings.sticky }}"
>
  <header
    class="header header--logo-{{ section.settings.layout }} header--icons-{{ section.settings.icon_style }} color-{{ section.settings.color_scheme }} gradient"
    style="{{ menu_style | strip_newlines }}"
  >
    <div class="page-width">
      <div class="header__inner">
        <div class="header__start">
          {{ menu_toggle }}
          {%- if section.settings.menu != blank -%}
            <nav class="header__menu" aria-label="{{ 'sections.header.primary_nav' | t }}">
              {%- render 'header-menu', menu: section.settings.menu -%}
            </nav>
          {%- endif -%}
        </div>

        <{{ logo_tag }} class="header__logo">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            {%- if logo != blank -%}
              {%- liquid
                assign logo_w = settings.logo_width_desktop | times: 2
                assign logo_sizes = '(min-width: 990px) ' | append: settings.logo_width_desktop | append: 'px, ' | append: settings.logo_width_mobile | append: 'px'
              -%}
              {{
                logo
                | image_url: width: logo_w
                | image_tag:
                  widths: '120, 180, 240, 360, 480',
                  sizes: logo_sizes,
                  loading: 'eager',
                  alt: shop.name
              }}
            {%- else -%}
              <span class="header__logo-text">{{ shop.name }}</span>
            {%- endif -%}
          </a>
        </{{ logo_tag }}>

        <div class="header__end">
          {%- if section.settings.menu_secondary != blank and section.settings.layout == 'center' -%}
            <nav class="header__menu" aria-label="{{ 'sections.header.secondary_nav' | t }}">
              {%- render 'header-menu', menu: section.settings.menu_secondary -%}
            </nav>
          {%- endif -%}
          {{ icons_end }}
        </div>
      </div>
    </div>

    {%- if section.settings.mobile_strip_menu != blank -%}
      <nav class="header__mobile-nav color-{{ section.settings.mobile_strip_scheme }} gradient" aria-label="{{ 'sections.header.shortcuts' | t }}">
        {%- for link in section.settings.mobile_strip_menu.links -%}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </header>
</sticky-header>

<dialog
  id="{{ menu_drawer_id }}"
  class="drawer menu-drawer color-{{ settings.drawer_color_scheme }}"
  aria-label="{{ 'sections.header.menu' | t }}"
>
  <div class="drawer__header color-{{ section.settings.color_scheme }} gradient">
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}">
      {%- if logo != blank -%}
        {{ logo | image_url: width: 240 | image_tag: loading: 'lazy', alt: shop.name, style: 'width: var(--logo-width-mobile); height: auto;' }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <button type="button" class="drawer__close" data-close-dialog aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon', icon: 'close' -%}
    </button>
  </div>

  <div class="drawer__body">
    {%- if section.blocks.size > 0 -%}
      {%- if section.settings.drawer_cards_heading != blank -%}
        <span class="menu-drawer__eyebrow">{{ section.settings.drawer_cards_heading }}</span>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_product = block.settings.product
          assign card_url = block.settings.link | default: card_product.url | default: '#'
          assign card_image = block.settings.image | default: card_product.featured_image
          assign card_title = block.settings.title | default: card_product.title
        -%}
        <a href="{{ card_url }}" class="menu-drawer__card" {{ block.shopify_attributes }}>
          {%- if card_image -%}
            {{ card_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 60, height: 60, alt: '' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span>
            <b>{{ card_title | escape }}</b>
            {%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}
          </span>
          {%- render 'icon', icon: 'arrow-right' -%}
        </a>
      {%- endfor -%}
    {%- endif -%}

    {%- assign drawer_menu = section.settings.drawer_menu | default: section.settings.menu -%}
    {%- if drawer_menu != blank -%}
      {%- if section.settings.drawer_links_heading != blank -%}
        <span class="menu-drawer__eyebrow" style="margin-top: 18px;">{{ section.settings.drawer_links_heading }}</span>
      {%- endif -%}
      <ul class="menu-drawer__links" role="list">
        {%- for link in drawer_menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details>
                <summary>{{ link.title | escape }}{% render 'icon', icon: 'chevron-down' %}</summary>
                <ul role="list">
                  <li><a href="{{ link.url }}">{{ 'sections.header.view_all' | t }}</a></li>
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <li><a href="{{ routes.account_url }}">{{ 'sections.header.account' | t }}</a></li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if section.settings.drawer_footer_badge != blank or section.settings.drawer_footer_text != blank -%}
    <div class="drawer__footer menu-drawer__footer">
      {%- if section.settings.drawer_footer_badge != blank -%}
        <span class="badge">{{ section.settings.drawer_footer_badge }}</span>
      {%- endif -%}
      {%- if section.settings.drawer_footer_text != blank -%}
        <small>{{ section.settings.drawer_footer_text }}</small>
      {%- endif -%}
    </div>
  {%- endif -%}
</dialog>

{%- if section.settings.show_search -%}
  <dialog id="{{ search_id }}" class="search-modal" aria-label="{{ 'sections.header.search' | t }}">
    <form action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="Search-{{ section.id }}">{{ 'sections.header.search' | t }}</label>
      <input
        id="Search-{{ section.id }}"
        class="field__input"
        type="search"
        name="q"
        placeholder="{{ 'sections.header.search_placeholder' | t }}"
        autocomplete="off"
      >
      <input type="hidden" name="options[prefix]" value="last">
      <button type="submit" class="button button--small">{{ 'sections.header.search' | t }}</button>
      <button type="button" class="drawer__close" data-close-dialog aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
    </form>
  </dialog>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header-wrapper",
  "max_blocks": 8,
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "use_inverse_logo",
      "label": "Use logo for dark backgrounds",
      "default": true,
      "info": "Set it in Theme settings > Logo and favicon"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Logo centered, menus on both sides"
        },
        {
          "value": "left",
          "label": "Logo left, menu centered"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky header",
      "default": "always",
      "options": [
        {
          "value": "none",
          "label": "Off"
        },
        {
          "value": "always",
          "label": "Always"
        },
        {
          "value": "scroll-up",
          "label": "On scroll up"
        }
      ]
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Height (desktop)",
      "min": 44,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 40,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "Bottom border",
      "default": false
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "link_list",
      "id": "menu_secondary",
      "label": "Right-side menu",
      "info": "Desktop, centered-logo layout"
    },
    {
      "type": "range",
      "id": "menu_size",
      "label": "Menu text size",
      "min": 10,
      "max": 20,
      "step": 0.5,
      "unit": "px",
      "default": 12.5
    },
    {
      "type": "range",
      "id": "menu_letter_spacing",
      "label": "Menu letter spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "info": "In 1/100 em"
    },
    {
      "type": "checkbox",
      "id": "menu_uppercase",
      "label": "Uppercase menu",
      "default": true
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Space between menu items",
      "min": 8,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "checkbox",
      "id": "menu_toggle_desktop",
      "label": "Show menu button on desktop",
      "default": false
    },
    {
      "type": "link_list",
      "id": "mobile_strip_menu",
      "label": "Mobile shortcut strip",
      "info": "Optional row of links under the header on mobile"
    },
    {
      "type": "color_scheme",
      "id": "mobile_strip_scheme",
      "label": "Shortcut strip color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "default": "boxed",
      "options": [
        {
          "value": "boxed",
          "label": "Outlined box"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ]
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 14,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "select",
      "id": "cart_icon",
      "label": "Cart icon",
      "visible_if": "{{ section.settings.show_cart }}",
      "default": "bag",
      "options": [
        {
          "value": "bag",
          "label": "Bag"
        },
        {
          "value": "cart",
          "label": "Tote"
        },
        {
          "value": "basket",
          "label": "Basket"
        }
      ]
    },
    {
      "type": "image_picker",
      "id": "cart_icon_image",
      "label": "Custom cart icon",
      "visible_if": "{{ section.settings.show_cart }}"
    },
    {
      "type": "image_picker",
      "id": "menu_icon_image",
      "label": "Custom menu icon"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "search_icon_image",
      "label": "Custom search icon"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "account_icon_image",
      "label": "Custom account icon"
    },
    {
      "type": "header",
      "content": "Mobile menu drawer"
    },
    {
      "type": "text",
      "id": "drawer_cards_heading",
      "label": "Shortcut cards heading",
      "default": "✦ Tienda ✦"
    },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "Drawer menu",
      "info": "Defaults to the main menu"
    },
    {
      "type": "text",
      "id": "drawer_links_heading",
      "label": "Links heading",
      "default": "✦ Ayuda ✦"
    },
    {
      "type": "text",
      "id": "drawer_footer_badge",
      "label": "Footer badge"
    },
    {
      "type": "text",
      "id": "drawer_footer_text",
      "label": "Footer text"
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_inset",
      "label": "Side inset",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "box_radius_split",
      "label": "Different radius on each corner",
      "default": false,
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "range",
      "id": "box_radius_tl",
      "label": "Top left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_tr",
      "label": "Top right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_br",
      "label": "Bottom right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_bl",
      "label": "Bottom left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.box_enable and section.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_border_style",
      "label": "Border style",
      "default": "solid",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Border color",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Background color",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "color_background",
      "id": "box_bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_shadow",
      "label": "Shadow",
      "default": "none",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "hard",
          "label": "Hard (offset)"
        },
        {
          "value": "glow",
          "label": "Glow"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_shadow_color",
      "label": "Shadow color",
      "default": "#000000",
      "visible_if": "{{ section.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_effect",
      "label": "Hover effect",
      "default": "none",
      "visible_if": "{{ section.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "grow",
          "label": "Grow"
        },
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "dim",
          "label": "Dim"
        }
      ]
    },
    {
      "type": "range",
      "id": "box_max_width",
      "label": "Max width (0 = full)",
      "min": 0,
      "max": 1600,
      "step": 20,
      "default": 0,
      "visible_if": "{{ section.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_align",
