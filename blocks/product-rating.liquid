{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign s = block.settings
  assign rating_value = nil
  assign rating_scale = 5
  assign rating_count = 0
  assign rating_text = s.text

  if s.source == 'manual'
    assign rating_value = s.manual_rating
    assign rating_count = s.manual_count
  else
    assign app_rating = p.metafields.reviews.rating.value
    assign own_rating = p.metafields.custom.rating
    if s.source == 'auto' and app_rating != blank
      assign rating_value = app_rating.rating
      assign rating_scale = app_rating.scale_max
      assign rating_count = p.metafields.reviews.rating_count.value | default: 0
    elsif own_rating != blank
      if own_rating.type == 'rating'
        assign rating_value = own_rating.value.rating
        assign rating_scale = own_rating.value.scale_max
      else
        assign rating_value = own_rating.value
      endif
      assign rating_count = p.metafields.custom.rating_count.value | default: 0
      if p.metafields.custom.rating_text != blank
        assign rating_text = p.metafields.custom.rating_text.value
      endif
    endif
  endif

  assign rating_number = rating_value | times: 1.0
  if rating_value == blank or rating_number <= 0
    assign rating_value = nil
  endif

  if rating_value != nil
    assign value_label = rating_value | round: 1 | append: '/' | append: rating_scale
    assign count_label = 'products.product.reviews_count' | t: count: rating_count
    assign rating_text = rating_text | replace: '[rating]', value_label | replace: '[count]', rating_count
  endif
-%}
{%- if rating_value != nil -%}
  <div
    class="product-rating product-rating--{{ s.text_position }}"
    style="justify-content: {{ s.align }}; --rating-align: {{ s.align }}; --rating-gap: {{ s.gap }}px; --rating-text-size: {{ s.text_size }}px;{% if s.text_color != blank and s.text_color.alpha != 0 %} --rating-text-color: {{ s.text_color }};{% endif %}"
    data-box="{{ block.id }}" {{ block.shopify_attributes }}
  >
    {%- if s.link != blank -%}<a href="{{ s.link }}" class="product-rating__link">{%- endif -%}
    {%- render 'stars',
      rating: rating_value,
      scale: rating_scale,
      shape: s.star_shape,
      outline: s.star_outline,
      size: s.star_size,
      gap: s.star_gap,
      color: s.star_color,
      empty_color: s.empty_color
    -%}
    {%- if s.show_value -%}
      <span class="product-rating__value">{{ value_label }}</span>
    {%- endif -%}
    {%- if s.show_count and rating_count > 0 -%}
      <span class="product-rating__count">({{ count_label }})</span>
    {%- endif -%}
    {%- if rating_text != blank -%}
      <span class="product-rating__text">{{ rating_text }}</span>
    {%- endif -%}
    {%- if s.link != blank -%}</a>{%- endif -%}
  </div>
{%- elsif request.design_mode -%}
  <p class="product-rating product-rating--empty" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
    {{- 'products.product.rating_editor_hint' | t -}}
  </p>
{%- endif -%}
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

