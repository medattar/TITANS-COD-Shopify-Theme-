          "value": "landscape",
          "label": "16:9"
        },
        {
          "value": "square",
          "label": "1:1"
        },
        {
          "value": "vertical",
          "label": "4:5"
        },
        {
          "value": "portrait",
          "label": "9:16"
        }
      ]
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "Border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Shadow",
