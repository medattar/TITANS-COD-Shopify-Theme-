{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign s = block.settings
  assign v = p.selected_or_first_available_variant
-%}
<div
  class="product-price-block product-price-block--{{ s.size }}"
  data-variant-update="price-{{ block.id }}"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {%- if p != blank -%}
    {%- render 'price',
      product: p,
      variant: v,
      show_compare: s.show_compare,
      show_savings: s.show_savings,
      savings_format: s.savings_format,
      compare_prefix: s.compare_prefix,
      compare_size: s.compare_size,
      compare_size_mobile: s.compare_size_mobile,
      compare_color: s.compare_color,
      compare_line: s.compare_line,
      compare_weight: s.compare_weight,
      compare_gap: s.compare_gap,
      compare_letter: s.compare_letter,
      compare_strike: s.compare_strike,
      savings_text: s.savings_text,
      save_size: s.save_size,
      save_color: s.save_color,
      save_bg: s.save_bg,
      save_radius: s.save_radius,
      save_pad: s.save_pad,
      meta_layout: s.meta_layout
    -%}
    {%- if s.show_tax_note -%}
      <p class="product-price-block__note">
        {%- if cart.taxes_included -%}
          {{ 'products.product.taxes_included' | t }}
        {%- else -%}
          {{ 'products.product.taxes_excluded' | t }}
        {%- endif -%}
        {%- if s.shipping_note != blank %} · {{ s.shipping_note }}{% endif -%}
      </p>
    {%- endif -%}
  {%- endif -%}
</div>
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

