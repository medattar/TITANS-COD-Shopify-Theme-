{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign s = block.settings
  assign v = p.selected_or_first_available_variant
  assign state = 'in'
  if v.available == false
    assign state = 'out'
  elsif v.inventory_management == 'shopify' and v.inventory_policy == 'deny' and v.inventory_quantity > 0 and v.inventory_quantity <= s.low_threshold
    assign state = 'low'
  endif
-%}
<div
  class="stock-status stock-status--{{ s.style }} stock-status--{{ state }}"
  data-variant-update="stock-{{ block.id }}"
  role="status"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  <span class="status-dot" aria-hidden="true"></span>
  <span>
    {%- case state -%}
      {%- when 'out' -%}
        {{ s.out_text }}
      {%- when 'low' -%}
        {{ s.low_text | replace: '[count]', v.inventory_quantity }}
      {%- else -%}
        {{ s.in_text }}
    {%- endcase -%}
  </span>
</div>

