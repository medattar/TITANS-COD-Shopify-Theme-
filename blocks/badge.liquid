{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
{%- if s.text != blank -%}
  {%- liquid
    assign badge_unit = 'none'
    if s.font_size > 0
      assign badge_size = s.font_size | append: 'px'
    elsif s.size == 'large'
      assign badge_size = 'calc(var(--badge-size) * 1.15)'
    else
      assign badge_size = 'var(--badge-size)'
    endif
  -%}
  {%- unless s.style == 'eyebrow' and s.font_size == 0 -%}
    {%- capture fs -%}[data-box="{{ block.id }}"] :is(.badge, .eyebrow){%- endcapture -%}
    {%- render 'block-font-size', sel: fs, mobile: badge_size, desktop: badge_size, unit: badge_unit -%}
  {%- endunless -%}
  {%- capture badge_style -%}
    {%- if s.font_size > 0 %}font-size: {{ s.font_size }}px;{% endif -%}
    {%- if s.pad_y > 0 or s.pad_x > 0 %}padding: {% if s.pad_y > 0 %}{{ s.pad_y }}{% else %}5{% endif %}px {% if s.pad_x > 0 %}{{ s.pad_x }}{% else %}11{% endif %}px;{% endif -%}
    {%- if s.text_color != blank and s.text_color.alpha != 0 %}color: {{ s.text_color }};{% endif -%}
    {%- if s.bg_color != blank and s.bg_color.alpha != 0 %}background: {{ s.bg_color }};{% endif -%}
    {%- if s.border_width > 0 %}border: {{ s.border_width }}px solid {{ s.border_color | default: 'currentColor' }};{% endif -%}
    {%- if s.radius_tl > 0 or s.radius_tr > 0 or s.radius_br > 0 or s.radius_bl > 0 %}border-radius: {{ s.radius_tl }}px {{ s.radius_tr }}px {{ s.radius_br }}px {{ s.radius_bl }}px;{% endif -%}
  {%- endcapture -%}
  <div class="badge-block" style="justify-content: {{ s.align }};" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
    <span class="{% if s.style == 'eyebrow' %}eyebrow{% else %}badge badge--{{ s.style }}{% if s.size == 'large' %} badge--large{% endif %}{% endif %}"{% if badge_style != blank %} style="{{ badge_style | strip_newlines }}"{% endif %}>
      {%- if s.icon != 'none' -%}{%- render 'icon-or-image', icon: s.icon, size: s.icon_size, color: s.icon_color -%}{%- endif -%}
      {{- s.text -}}
    </span>
  </div>
{%- endif -%}

