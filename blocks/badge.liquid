{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
{%- if s.text != blank -%}
  <div class="badge-block" style="justify-content: {{ s.align }};" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
    <span class="{% if s.style == 'eyebrow' %}eyebrow{% else %}badge badge--{{ s.style }}{% if s.size == 'large' %} badge--large{% endif %}{% endif %}">
      {%- if s.icon != 'none' -%}{%- render 'icon', icon: s.icon -%}{%- endif -%}
      {{- s.text -}}
    </span>
  </div>
{%- endif -%}

