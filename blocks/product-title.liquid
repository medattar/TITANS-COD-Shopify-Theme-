{%- liquid
  assign p = block.settings.product | default: closest.product
  assign s = block.settings
  assign tag = s.tag
  if tag == 'auto'
    if template.name == 'product' and section.settings.update_url != nil
      assign tag = 'h1'
    else
      assign tag = 'h2'
    endif
  endif
-%}
<div class="product-title-block" {{ block.shopify_attributes }}>
  {%- if s.show_vendor and p.vendor != blank -%}
    <p class="product-title-block__vendor">{{ p.vendor | escape }}</p>
  {%- endif -%}
  <{{ tag }}
    class="product-title font-{{ s.font }}"
    style="--pt-size-d: {{ s.size_desktop }}px; --pt-size-m: {{ s.size_mobile }}px;"
  >
    {%- if p != blank -%}
      {%- if tag != 'h1' -%}<a href="{{ p.url }}">{{ p.title | escape }}</a>{%- else -%}{{ p.title | escape }}{%- endif -%}
    {%- else -%}
      {{ 'products.product.title_placeholder' | t }}
    {%- endif -%}
  </{{ tag }}>
  {%- if s.show_sku -%}
    {%- assign v = p.selected_or_first_available_variant -%}
    <p class="product-title-block__sku" data-variant-update="sku-{{ block.id }}"{% if v.sku == blank %} hidden{% endif %}>
      {{- 'products.product.sku' | t }}: {{ v.sku -}}
    </p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product title",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    {
      "type": "select", "id": "font", "label": "Font", "default": "display",
      "options": [ { "value": "display", "label": "Display" }, { "value": "heading", "label": "Heading" }, { "value": "body", "label": "Body" } ]
    },
    { "type": "range", "id": "size_desktop", "label": "Size (desktop)", "min": 18, "max": 96, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "size_mobile", "label": "Size (mobile)", "min": 16, "max": 64, "step": 1, "unit": "px", "default": 38 },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false },
    {
      "type": "select", "id": "tag", "label": "HTML tag", "default": "auto",
      "info": "Auto uses H1 on product pages",
      "options": [ { "value": "auto", "label": "Auto" }, { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "p", "label": "Paragraph" } ]
    }
  ],
  "presets": [
    { "name": "Product title", "settings": { "product": "{{ closest.product }}" } }
  ]
}
{% endschema %}
