{%- liquid
  assign p = block.settings.product | default: closest.product
  assign s = block.settings
  assign v = p.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
    assign saved = v.compare_at_price | minus: v.price
    assign percent = saved | times: 100.0 | divided_by: v.compare_at_price | round
  endif
-%}
<div class="offer-stack color-{{ s.color_scheme }}" {{ block.shopify_attributes }}>
  <div class="offer-stack__header">
    <b>{{ s.heading }}</b>
    <span data-variant-update="offer-badge-{{ block.id }}">
      {%- if s.show_discount and on_sale -%}
        <span class="badge badge--accent">{{ s.discount_label | replace: '[percent]', percent }}</span>
      {%- endif -%}
    </span>
  </div>

  <ul class="offer-stack__list" role="list">
    {%- if s.show_product_row and p != blank -%}
      <li class="offer-stack__row offer-stack__row--product">
        <span class="offer-stack__thumb">
          {%- assign row_media = v.featured_media | default: p.featured_media -%}
          {%- if row_media -%}
            {{ row_media | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', width: 44, height: 44, alt: '' }}
          {%- endif -%}
        </span>
        <span class="offer-stack__text">
          <b>{{ s.product_row_title | default: p.title }}</b>
          {%- if s.product_row_subtitle != blank -%}<small>{{ s.product_row_subtitle }}</small>{%- endif -%}
        </span>
        <span class="offer-stack__value" data-variant-update="offer-value-{{ block.id }}">
          {%- if on_sale -%}
            <b>{% render 'format-money', amount: v.compare_at_price %}</b>
          {%- else -%}
            <b>{% render 'format-money', amount: v.price %}</b>
          {%- endif -%}
        </span>
      </li>
    {%- endif -%}
    {% content_for 'blocks' %}
  </ul>

  {%- if s.show_today -%}
    <div class="offer-stack__today" data-variant-update="offer-today-{{ block.id }}">
      <div class="offer-stack__today-left">
        <span>{{ s.today_label }}</span>
        <div class="offer-stack__today-price">
          {%- if on_sale -%}<s><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{% render 'format-money', amount: v.compare_at_price %}</s>{%- endif -%}
          <b>{% render 'format-money', amount: v.price %}</b>
        </div>
      </div>
      {%- if on_sale and s.savings_label != blank -%}
        {%- capture saved_money -%}{% render 'format-money', amount: saved %}{%- endcapture -%}
        <em class="badge badge--accent">{{ s.savings_label | replace: '[amount]', saved_money | replace: '[percent]', percent }}</em>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Offer stack",
  "tag": null,
  "blocks": [{ "type": "_offer-item" }],
  "settings": [
    { "type": "paragraph", "content": "Prices and savings come from the selected variant's real price and compare-at price." },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Todo lo que recibes" },
    { "type": "checkbox", "id": "show_discount", "label": "Show discount badge", "default": true },
    { "type": "text", "id": "discount_label", "label": "Discount badge text", "default": "-[percent]%", "info": "[percent] is replaced with the real discount" },
    { "type": "header", "content": "Product row" },
    { "type": "checkbox", "id": "show_product_row", "label": "Show product row", "default": true },
    { "type": "text", "id": "product_row_title", "label": "Title override" },
    { "type": "text", "id": "product_row_subtitle", "label": "Subtitle" },
    { "type": "header", "content": "Today's price strip" },
    { "type": "checkbox", "id": "show_today", "label": "Show price strip", "default": true },
    { "type": "text", "id": "today_label", "label": "Label", "default": "Hoy" },
    { "type": "text", "id": "savings_label", "label": "Savings text", "default": "Ahorras [amount]", "info": "[amount] and [percent] are replaced with real values" }
  ],
  "presets": [
    {
      "name": "Offer stack",
      "settings": { "product": "{{ closest.product }}" },
      "blocks": [
        { "type": "_offer-item", "settings": { "title": "Envío con seguimiento", "value": "Incluido" } },
        { "type": "_offer-item", "settings": { "title": "Pago contra entrega", "value": "Disponible" } },
        { "type": "_offer-item", "settings": { "title": "Atención por WhatsApp", "value": "Incluido" } }
      ]
    }
  ]
}
{% endschema %}
