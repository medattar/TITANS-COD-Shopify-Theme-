{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
{%- capture fs -%}[data-box="{{ block.id }}"] .trust-badge__text{%- endcapture -%}
{%- render 'block-font-size', sel: fs, mobile: s.text_size_mobile, desktop: s.text_size -%}
<ul
  class="trust-badges trust-badges--{{ s.style }} trust-badges--align-{{ s.align }}"
  role="list"
  style="--tb-cols: {{ s.columns }}; --tb-cols-m: {{ s.columns_mobile }}; --tb-gap: {{ s.gap }}px; --tb-icon: {{ s.icon_size }}px; --tb-icon-m: {{ s.icon_size_mobile }}px; --tb-size: {{ s.text_size }}px; --tb-size-m: {{ s.text_size_mobile }}px; --tb-font: var(--font-{{ s.font }}-family); --tb-weight: {{ s.weight }}; --tb-transform: {{ s.transform }}; --tb-letter: {{ s.letter_spacing | divided_by: 100.0 }}em; --tb-line: {{ s.line_height | divided_by: 10.0 }};{% if s.icon_color != blank and s.icon_color.alpha != 0 %} --tb-icon-color: {{ s.icon_color }};{% endif %}{% if s.text_color != blank and s.text_color.alpha != 0 %} --tb-color: {{ s.text_color }};{% endif %}{% if s.box_color != blank and s.box_color.alpha != 0 %} --tb-box: {{ s.box_color }};{% endif %}"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</ul>
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

