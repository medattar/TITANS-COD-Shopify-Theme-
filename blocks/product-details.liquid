{%- liquid
  assign p = block.settings.product | default: closest.product
  assign s = block.settings
  assign dialog_id = 'ProductDetails-' | append: block.id
  assign specs = p.metafields.custom.specifications
  assign included = p.metafields.custom.included.value
-%}
<div class="product-details-block" {{ block.shopify_attributes }}>
  <button type="button" class="button button--{{ s.button_style }} button--full product-details-block__button" data-open-dialog="{{ dialog_id }}" aria-haspopup="dialog">
    {%- if s.icon != 'none' -%}{%- render 'icon', icon: s.icon -%}{%- endif -%}
    <span>{{ s.label }}</span>
  </button>

  <dialog id="{{ dialog_id }}" class="drawer drawer--{{ s.position }} product-details-drawer color-{{ s.color_scheme }}" aria-labelledby="{{ dialog_id }}-title">
    <div class="drawer__header">
      <h2 class="drawer__title" id="{{ dialog_id }}-title">{{ s.heading | default: p.title }}</h2>
      <button type="button" class="drawer__close" data-close-dialog aria-label="{{ 'accessibility.close' | t }}">
        {%- render 'icon', icon: 'close' -%}
      </button>
    </div>
    <div class="drawer__body product-details-drawer__body">
      {%- if s.intro != blank -%}
        <div class="rte">{{ s.intro }}</div>
      {%- endif -%}
      {%- if s.show_description and p.description != blank -%}
        <div class="rte product-details-drawer__description">{{ p.description }}</div>
      {%- endif -%}
      {%- if s.show_included and included != blank -%}
        <h3 class="product-details-drawer__heading">{{ s.included_heading }}</h3>
        <ul class="product-details-drawer__list" role="list">
          {%- for item in included -%}
            <li>{%- render 'icon', icon: 'check' -%}<span>{{ item }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if s.show_specs and specs != blank -%}
        <h3 class="product-details-drawer__heading">{{ s.specs_heading }}</h3>
        {%- if specs.type == 'rich_text_field' -%}
          <div class="rte">{{ specs | metafield_tag }}</div>
        {%- elsif specs.type contains 'list.' -%}
          <ul class="product-details-drawer__list" role="list">
            {%- for item in specs.value -%}
              <li>{%- render 'icon', icon: 'dot' -%}<span>{{ item }}</span></li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <div class="rte">{{ specs.value }}</div>
        {%- endif -%}
      {%- endif -%}
      {%- if s.page != blank -%}
        <div class="rte">{{ s.page.content }}</div>
      {%- endif -%}
    </div>
  </dialog>
</div>

{% schema %}
{
  "name": "Product details drawer",
  "tag": null,
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "label", "label": "Button label", "default": "Detalles del producto" },
    {
      "type": "select", "id": "button_style", "label": "Button style", "default": "secondary",
      "options": [ { "value": "primary", "label": "Primary" }, { "value": "secondary", "label": "Secondary" }, { "value": "outline", "label": "Outline" }, { "value": "link", "label": "Text link" } ]
    },
    { "type": "select", "id": "icon", "label": "Button icon", "default": "info", "options": [{"value": "none", "label": "None"}, {"value": "check", "label": "Check"}, {"value": "check-circle", "label": "Check circle"}, {"value": "sparkle", "label": "Sparkle"}, {"value": "star", "label": "Star"}, {"value": "heart", "label": "Heart"}, {"value": "shield", "label": "Shield"}, {"value": "verified", "label": "Verified badge"}, {"value": "truck", "label": "Truck"}, {"value": "package-check", "label": "Package"}, {"value": "box", "label": "Box"}, {"value": "cash", "label": "Cash"}, {"value": "credit-card", "label": "Card"}, {"value": "lock", "label": "Lock"}, {"value": "return", "label": "Return"}, {"value": "gift", "label": "Gift"}, {"value": "clock", "label": "Clock"}, {"value": "calendar", "label": "Calendar"}, {"value": "phone", "label": "Phone"}, {"value": "chat", "label": "Chat"}, {"value": "whatsapp", "label": "WhatsApp"}, {"value": "mail", "label": "Mail"}, {"value": "headset", "label": "Support"}, {"value": "location", "label": "Location"}, {"value": "home", "label": "Home"}, {"value": "globe", "label": "Globe"}, {"value": "leaf", "label": "Leaf"}, {"value": "droplet", "label": "Droplet"}, {"value": "moon", "label": "Moon"}, {"value": "sun", "label": "Sun"}, {"value": "bolt", "label": "Bolt"}, {"value": "battery", "label": "Battery"}, {"value": "award", "label": "Award"}, {"value": "percent", "label": "Percent"}, {"value": "tag", "label": "Tag"}, {"value": "thumbs-up", "label": "Thumbs up"}, {"value": "smile", "label": "Smile"}, {"value": "users", "label": "Users"}, {"value": "eye", "label": "Eye"}, {"value": "info", "label": "Info"}] },
    {
      "type": "select", "id": "position", "label": "Drawer position", "default": "right",
      "options": [ { "value": "right", "label": "Right" }, { "value": "bottom", "label": "Bottom sheet" } ]
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Drawer color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Drawer heading", "info": "Defaults to the product title" },
    { "type": "richtext", "id": "intro", "label": "Intro text" },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": true },
    { "type": "checkbox", "id": "show_included", "label": "Show custom.included metafield", "default": true },
    { "type": "text", "id": "included_heading", "label": "Included heading", "default": "Qué incluye" },
    { "type": "checkbox", "id": "show_specs", "label": "Show custom.specifications metafield", "default": true },
    { "type": "text", "id": "specs_heading", "label": "Specifications heading", "default": "Especificaciones" },
    { "type": "page", "id": "page", "label": "Append page content" }
  ],
  "presets": [
    { "name": "Product details drawer", "settings": { "product": "{{ closest.product }}" } }
  ]
}
{% endschema %}
