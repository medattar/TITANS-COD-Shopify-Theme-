{%- assign s = block.settings -%}
<li class="trust-badge" {{ block.shopify_attributes }}>
  <span class="trust-badge__icon">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 96 | image_tag: loading: 'lazy', width: 28, height: 28, alt: '' }}
    {%- else -%}
      {%- render 'icon', icon: s.icon -%}
    {%- endif -%}
  </span>
  <span class="trust-badge__text">{{ s.text }}</span>
</li>

{% schema %}
{
  "name": "Trust badge",
  "tag": null,
  "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [{"value": "none", "label": "None"}, {"value": "check", "label": "Check"}, {"value": "check-circle", "label": "Check circle"}, {"value": "sparkle", "label": "Sparkle"}, {"value": "star", "label": "Star"}, {"value": "heart", "label": "Heart"}, {"value": "shield", "label": "Shield"}, {"value": "verified", "label": "Verified badge"}, {"value": "truck", "label": "Truck"}, {"value": "package-check", "label": "Package"}, {"value": "box", "label": "Box"}, {"value": "cash", "label": "Cash"}, {"value": "credit-card", "label": "Card"}, {"value": "lock", "label": "Lock"}, {"value": "return", "label": "Return"}, {"value": "gift", "label": "Gift"}, {"value": "clock", "label": "Clock"}, {"value": "calendar", "label": "Calendar"}, {"value": "phone", "label": "Phone"}, {"value": "chat", "label": "Chat"}, {"value": "whatsapp", "label": "WhatsApp"}, {"value": "mail", "label": "Mail"}, {"value": "headset", "label": "Support"}, {"value": "location", "label": "Location"}, {"value": "home", "label": "Home"}, {"value": "globe", "label": "Globe"}, {"value": "leaf", "label": "Leaf"}, {"value": "droplet", "label": "Droplet"}, {"value": "moon", "label": "Moon"}, {"value": "sun", "label": "Sun"}, {"value": "bolt", "label": "Bolt"}, {"value": "battery", "label": "Battery"}, {"value": "award", "label": "Award"}, {"value": "percent", "label": "Percent"}, {"value": "tag", "label": "Tag"}, {"value": "thumbs-up", "label": "Thumbs up"}, {"value": "smile", "label": "Smile"}, {"value": "users", "label": "Users"}, {"value": "eye", "label": "Eye"}, {"value": "info", "label": "Info"}] },
    { "type": "image_picker", "id": "image", "label": "Image instead of icon" },
    { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Compra segura" }
  ]
}
{% endschema %}
