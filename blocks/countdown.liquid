{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
<div class="countdown-block" style="--cd-align: {{ s.align }};" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
    {%- if s.label != blank -%}
      <p class="countdown-block__label">{{ s.label }}</p>
    {%- endif -%}
    {%- render 'countdown',
      date: s.date,
      time: s.time,
      style: s.style,
      effect: s.effect,
      expired_text: s.expired_text,
      number_size: s.number_size,
      label_size: s.label_size,
      gap: s.gap,
      radius: s.radius,
      number_color: s.number_color,
      label_color: s.label_color,
      background: s.background,
      border_color: s.border_color,
      effect_speed: s.effect_speed,
      urgent_minutes: s.urgent_minutes,
      show_days: s.show_days,
      show_hours: s.show_hours,
      show_minutes: s.show_minutes,
      show_seconds: s.show_seconds,
      duration_days: s.duration_days,
      duration_hours: s.duration_hours,
      duration_minutes: s.duration_minutes,
      scale: s.scale,
      storage_key: block.id
    -%}
</div>

