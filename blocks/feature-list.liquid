{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign s = block.settings
  assign glyph = s.glyph | default: '✦' | remove: "'" | remove: '"' | remove: '\\'
  assign mode = 'svg'
  if s.image != blank
    assign mode = 'image'
  elsif s.icon == 'glyph' or s.icon == 'none'
    assign mode = s.icon
  endif
  if mode == 'svg'
    capture icon_svg
      render 'icon', icon: s.icon
    endcapture
    assign icon_svg = icon_svg | strip_newlines | replace: 'stroke-linecap', 'stroke-width="2" stroke-linecap' | replace: '"', "'" | replace: '<', '%3C' | replace: '>', '%3E' | replace: '#', '%23'
  endif
-%}
{%- capture fs -%}[data-box="{{ block.id }}"] .feature-list__text{%- endcapture -%}
{%- render 'block-font-size', sel: fs, mobile: s.text_size_mobile, desktop: s.text_size -%}
<ul
  class="feature-list feature-list--{{ s.layout }} feature-list--{{ s.align }} feature-list--icon-{{ mode }}"
  role="list"
  style="--fl-icon-size: {{ s.icon_size }}px; --fl-icon-color: {{ s.icon_color | default: 'var(--color-accent)' }}; --fl-size: {{ s.text_size_mobile }}px; --fl-size-d: {{ s.text_size }}px; --fl-gap: {{ s.item_gap }}px; --fl-icon-gap: {{ s.icon_gap }}px; --fl-line: {{ s.line_height | divided_by: 10.0 }}; --fl-glyph: '{{ glyph | escape }}';{% if mode == 'svg' %} --fl-mask: url(&quot;data:image/svg+xml,{{ icon_svg }}&quot;);{% endif %}{% if mode == 'image' %} --fl-image: url('{{ s.image | image_url: width: 96 }}');{% endif %}{% if s.text_color != blank and s.text_color.alpha != 0 %} --fl-color: {{ s.text_color }};{% endif %}{% if s.bold_color != blank and s.bold_color.alpha != 0 %} --fl-bold-color: {{ s.bold_color }};{% endif %}"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</ul>

