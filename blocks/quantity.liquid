{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign v = p.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign input_id = 'Quantity-' | append: block.id
-%}
<div class="quantity-block" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
  <label class="quantity-block__label" for="{{ input_id }}">{{ block.settings.label }}</label>
  <quantity-input class="quantity">
    <button type="button" class="quantity__button" data-qty="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: p.title | escape }}">
      {%- render 'icon', icon: 'minus' -%}
    </button>
    <input
      class="quantity__input"
      id="{{ input_id }}"
      type="number"
      inputmode="numeric"
      name="quantity"
      form="{{ form_id }}"
      value="{{ v.quantity_rule.min | default: 1 }}"
      min="{{ v.quantity_rule.min | default: 1 }}"
      {% if v.quantity_rule.max != null %}
        max="{{ v.quantity_rule.max }}"
      {% endif %}
      step="{{ v.quantity_rule.increment | default: 1 }}"
    >
    <button type="button" class="quantity__button" data-qty="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: p.title | escape }}">
      {%- render 'icon', icon: 'plus' -%}
    </button>
  </quantity-input>
</div>

{% schema %}
