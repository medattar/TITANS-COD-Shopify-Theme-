{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
<div
  class="icon-text icon-text--{{ s.layout }}"
  style="--it-icon: {{ s.icon_size }}px; --it-color: var(--color-{{ s.icon_color }}); --it-title: {{ s.title_size }}px;"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {%- if s.image != blank or s.icon != 'none' -%}
    <span class="icon-text__icon{% if s.icon_circle %} icon-text__icon--circle{% endif %}">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: s.icon_size, height: s.icon_size }}
      {%- else -%}
        {%- render 'icon', icon: s.icon -%}
      {%- endif -%}
    </span>
  {%- endif -%}
  <div class="icon-text__body">
    {%- if s.title != blank -%}<b class="icon-text__title">{{ s.title }}</b>{%- endif -%}
    {%- if s.text != blank -%}<div class="icon-text__text">{{ s.text }}</div>{%- endif -%}
  </div>
</div>

