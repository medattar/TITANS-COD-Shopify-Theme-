{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
<div
  class="cod-notice cod-notice--{{ s.style }}{% if s.use_scheme %} color-{{ s.color_scheme }} gradient{% endif %}"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {%- if s.icon != 'none' or s.image != blank -%}
    <span class="cod-notice__icon">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 120 | image_tag: loading: 'lazy', width: 40, height: 40, alt: '' }}
      {%- else -%}
        {%- render 'icon', icon: s.icon -%}
      {%- endif -%}
    </span>
  {%- endif -%}
  <div class="cod-notice__body">
    {%- if s.title != blank -%}<b class="cod-notice__title">{{ s.title }}</b>{%- endif -%}
    {%- if s.text != blank -%}<div class="cod-notice__text">{{ s.text }}</div>{%- endif -%}
    {%- if s.link_label != blank and s.link != blank -%}
      <a class="cod-notice__link link" href="{{ s.link }}">{{ s.link_label }}</a>
    {%- endif -%}
  </div>
</div>

