{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign s = block.settings -%}
{%- if s.quote != blank -%}
  <div
    class="testimonial-card{% if s.use_scheme %} color-{{ s.color_scheme }} gradient{% endif %}{% if s.shadow %} testimonial-card--shadow{% endif %}"
    data-box="{{ block.id }}" {{ block.shopify_attributes }}
  >
    {%- if s.avatar != blank -%}
      {{ s.avatar | image_url: width: 160, height: 160, crop: 'center' | image_tag: loading: 'lazy', class: 'testimonial-card__avatar', width: 64, height: 64, alt: s.name }}
    {%- endif -%}
    <div class="testimonial-card__body">
      {%- if s.rating > 0 -%}
        {%- render 'stars', rating: s.rating, scale: 5 -%}
      {%- endif -%}
      <blockquote class="testimonial-card__quote">{{ s.quote }}</blockquote>
      <div class="testimonial-card__author">
        <b class="testimonial-card__name">{{ s.name }}</b>
        {%- if s.role != blank -%}<span class="testimonial-card__role"> · {{ s.role }}</span>{%- endif -%}
        {%- if s.verified_label != blank -%}
          <span class="testimonial-card__verified">{%- render 'icon', icon: 'verified' -%}{{ s.verified_label }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- else -%}
  {%- render 'block-placeholder', message: 'Add a real customer quote to show this testimonial.' -%}
{%- endif -%}
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

{% schema %}
{
  "name": "Testimonial card",
  "tag": null,
  "settings": [
    {"type": "select", "id": "show_on", "label": "Show on", "default": "all", "options": [{"value": "all", "label": "All products"}, {"value": "selected", "label": "Only the products below"}]},
    {"type": "product_list", "id": "show_products", "label": "Products", "limit": 50, "info": "Used when Show on is set to Only the products below."},
    {
      "type": "paragraph",
      "content": "Only publish genuine testimonials from real customers, with their permission."
    },
    {
      "type": "image_picker",
      "id": "avatar",
      "label": "Photo"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Star rating given by the customer (0 = hide)",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 0
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Nombre del cliente"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Location or role"
    },
    {
      "type": "text",
      "id": "verified_label",
      "label": "Verified label",
      "info": "Only use for verified purchases"
    },
    {
      "type": "checkbox",
      "id": "use_scheme",
      "label": "Use a color scheme",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py",
      "label": "Inner padding top/bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px",
      "label": "Inner padding left/right (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py_m",
      "label": "Inner padding top/bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px_m",
      "label": "Inner padding left/right (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "box_radius_split",
      "label": "Different radius on each corner",
      "default": false,
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "range",
      "id": "box_radius_tl",
