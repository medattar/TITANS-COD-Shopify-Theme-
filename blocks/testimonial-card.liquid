      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_bl",
      "label": "Bottom left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
