    },
    {
      "type": "range",
      "id": "tx_line",
      "label": "Line height (10 = 1.0, 0 = default)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "select",
      "id": "tx_transform",
      "label": "Letter case",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
