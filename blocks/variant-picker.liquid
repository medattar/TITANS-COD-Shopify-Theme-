{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign s = block.settings
  assign style = s.style
  if style == 'cards' and p.options.size > 1
    assign style = 'buttons'
  endif
-%}
{%- unless p == blank or p.has_only_default_variant -%}
  <variant-picker
    class="variant-picker variant-picker--{{ style }}"
    data-variant-update="picker-{{ block.id }}"
    data-box="{{ block.id }}" {{ block.shopify_attributes }}
  >
    {%- for option in p.options_with_values -%}
      {%- assign option_index = forloop.index0 -%}
      {%- assign input_name = block.id | append: '-' | append: option.position -%}
      <fieldset class="variant-picker__option" data-option-index="{{ option_index }}">
        <legend class="variant-picker__legend">
          {{- option.name | escape -}}
          {%- if s.show_selected -%}: <span>{{ option.selected_value | escape }}</span>{%- endif -%}
        </legend>

        {%- if style == 'dropdown' -%}
          <div class="select">
            <select class="field__input" name="{{ input_name }}" aria-label="{{ option.name | escape }}">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"{% if value.selected %} selected{% endif %}>
                  {{- value | escape -}}
                  {%- unless value.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
                </option>
              {%- endfor -%}
            </select>
            {%- render 'icon', icon: 'chevron-down' -%}
          </div>
        {%- else -%}
          <div class="variant-picker__values">
            {%- for value in option.values -%}
              {%- assign input_id = input_name | append: '-' | append: forloop.index -%}
              <input
                class="variant-picker__input visually-hidden"
                type="radio"
                id="{{ input_id }}"
                name="{{ input_name }}"
                value="{{ value | escape }}"
                {% if value.selected %}
                  checked
                {% endif %}
              >
              {%- if style == 'cards' -%}
                {%- liquid
                  assign vv = value.variant
                  assign card_saved = 0
                  if vv.compare_at_price > vv.price
                    assign card_saved = vv.compare_at_price | minus: vv.price
                  endif
                -%}
                <label for="{{ input_id }}" class="variant-card{% unless value.available %} is-unavailable{% endunless %}">
                  <span class="variant-card__media">
                    {%- if vv.featured_media -%}
                      {{ vv.featured_media | image_url: width: 140, height: 140, crop: 'center' | image_tag: loading: 'lazy', width: 60, height: 60, alt: '' }}
                    {%- elsif p.featured_media -%}
                      {{ p.featured_media | image_url: width: 140, height: 140, crop: 'center' | image_tag: loading: 'lazy', width: 60, height: 60, alt: '' }}
                    {%- endif -%}
                  </span>
                  <span class="variant-card__mid">
                    <b>{{ value | escape }}</b>
                    {%- if card_saved > 0 and s.show_card_savings -%}
                      {%- capture card_saved_money -%}{% render 'format-money', amount: card_saved %}{%- endcapture -%}
                      <em>{{ s.card_savings_label | replace: '[amount]', card_saved_money }}</em>
                    {%- endif -%}
                    {%- unless value.available -%}<em>{{ 'products.product.sold_out' | t }}</em>{%- endunless -%}
                  </span>
                  {%- if vv -%}
                    <span class="variant-card__price">
                      <b>{% render 'format-money', amount: vv.price %}</b>
                      {%- if card_saved > 0 -%}<s><span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>{% render 'format-money', amount: vv.compare_at_price %}</s>{%- endif -%}
                    </span>
                  {%- endif -%}
                </label>
              {%- else -%}
                {%- liquid
                  assign swatch_style = ''
                  if s.use_swatches and value.swatch
                    if value.swatch.image
                      assign swatch_url = value.swatch.image | image_url: width: 80
                      assign swatch_style = 'background-image: url(' | append: swatch_url | append: ');'
                    elsif value.swatch.color
                      assign swatch_style = 'background-color: ' | append: value.swatch.color | append: ';'
                    endif
                  endif
                -%}
                <label
                  for="{{ input_id }}"
                  class="variant-pill{% unless value.available %} is-unavailable{% endunless %}{% if swatch_style != '' %} variant-pill--swatch{% endif %}"
                  {% if swatch_style != '' %}
                    title="{{ value | escape }}"
                  {% endif %}
                >
                  {%- if swatch_style != '' -%}
                    <span class="variant-pill__swatch" style="{{ swatch_style }}"></span>
                    <span class="visually-hidden">{{ value | escape }}</span>
                  {%- else -%}
                    {{- value | escape -}}
                  {%- endif -%}
                  {%- unless value.available -%}<span class="visually-hidden"> — {{ 'products.product.sold_out' | t }}</span>{%- endunless -%}
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}
  </variant-picker>
{%- else -%}
  <div hidden data-box="{{ block.id }}" {{ block.shopify_attributes }}></div>
{%- endunless -%}

{% schema %}
{
  "name": "Variant picker",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "buttons",
      "info": "Cards suit bundle variants (e.g. 1, 2 or 3 units) on single-option products",
      "options": [
        {
          "value": "buttons",
          "label": "Buttons"
        },
        {
          "value": "dropdown",
          "label": "Dropdown"
        },
        {
          "value": "cards",
          "label": "Cards with image and price"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_selected",
      "label": "Show selected value in label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_swatches",
      "label": "Use Shopify color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_savings",
      "label": "Show savings on cards",
      "default": true
    },
    {
      "type": "text",
      "id": "card_savings_label",
      "label": "Card savings text",
      "default": "Ahorras [amount]"
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py",
      "label": "Inner padding top/bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px",
      "label": "Inner padding left/right (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py_m",
      "label": "Inner padding top/bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px_m",
      "label": "Inner padding left/right (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_border_style",
      "label": "Border style",
      "default": "solid",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Background color",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "color_background",
      "id": "box_bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_shadow",
      "label": "Shadow",
      "default": "none",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "hard",
          "label": "Hard (offset)"
        },
        {
          "value": "glow",
          "label": "Glow"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_shadow_color",
      "label": "Shadow color",
      "default": "#000000",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_effect",
      "label": "Hover effect",
      "default": "none",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "grow",
          "label": "Grow"
        },
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "dim",
          "label": "Dim"
        }
      ]
    },
    {
      "type": "range",
      "id": "box_max_width",
      "label": "Max width (0 = full)",
      "min": 0,
      "max": 1600,
      "step": 20,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_align",
      "label": "Position when narrower",
      "default": "center",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "checkbox",
      "id": "tx_enable",
      "label": "Customize fonts and spacing",
      "default": false
    },
    {
      "type": "select",
      "id": "tx_font",
      "label": "Font",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "display",
          "label": "Display"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        }
      ]
    },
    {
      "type": "select",
      "id": "tx_weight",
      "label": "Weight",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "tx_size",
      "label": "Font size, desktop (0 = default)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_size_m",
      "label": "Font size, mobile (0 = default)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_letter",
      "label": "Letter spacing (1/100 em)",
      "min": -10,
      "max": 40,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_word",
      "label": "Word spacing (1/100 em)",
      "min": -20,
      "max": 100,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_line",
      "label": "Line height (10 = 1.0, 0 = default)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "select",
      "id": "tx_transform",
      "label": "Letter case",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "none",
          "label": "As typed"
        },
        {
          "value": "uppercase",
          "label": "UPPERCASE"
        },
        {
          "value": "lowercase",
          "label": "lowercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ]
    },
    {
      "type": "select",
      "id": "tx_align",
      "label": "Alignment",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "color",
      "id": "tx_color",
      "label": "Text color",
      "visible_if": "{{ block.settings.tx_enable }}"
    }
  ],
  "presets": [
    {
      "name": "Variant picker",
      "settings": {
        "product": "{{ closest.product }}"
      }
    }
  ]
}
{% endschema %}
