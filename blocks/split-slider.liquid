{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign s = block.settings
  case s.ratio
    when 'adapt'
      if s.after != blank
        assign ratio = s.after.aspect_ratio
      elsif s.before != blank
        assign ratio = s.before.aspect_ratio
      else
        assign ratio = '4 / 5'
      endif
    else
      assign ratio = s.ratio
  endcase
  assign sizes = '(min-width: 990px) ' | append: s.width | append: 'vw, 100vw'
-%}
<figure
  class="split-slider-block"
  style="--ss-width: {{ s.width }}%; --ss-align: {{ s.align }};"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  <split-slider
    class="split-slider split-slider--{{ s.orientation }} split-slider--handle-{{ s.handle_style }}{% if s.hover_follow %} split-slider--follow{% endif %}"
    data-orientation="{{ s.orientation }}"
    {% if s.hover_follow %}data-follow{% endif %}
    style="--ratio: {{ ratio }}; --pos: {{ s.start }}%; --ss-fit: {{ s.fit }}; --ss-radius: {{ s.radius }}px; --ss-line: {{ s.line_color }}; --ss-line-width: {{ s.line_width }}px; --ss-handle: {{ s.handle_color }}; --ss-handle-icon: {{ s.handle_icon_color }}; --ss-handle-size: {{ s.handle_size }}px; --ss-label-bg: {{ s.label_bg }}; --ss-label-text: {{ s.label_text }}; --ss-label-size: {{ s.label_size }}px;"
  >
    <div class="split-slider__layer split-slider__layer--after">
      {%- if s.after != blank -%}
        {%- render 'image', image: s.after, sizes: sizes -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="split-slider__layer split-slider__layer--before">
      {%- if s.before != blank -%}
        {%- render 'image', image: s.before, sizes: sizes -%}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    {%- if s.show_labels -%}
      {%- if s.before_label != blank -%}
        <span class="split-slider__label split-slider__label--before split-slider__label--{{ s.label_position }}">{{ s.before_label }}</span>
      {%- endif -%}
      {%- if s.after_label != blank -%}
        <span class="split-slider__label split-slider__label--after split-slider__label--{{ s.label_position }}">{{ s.after_label }}</span>
      {%- endif -%}
    {%- endif -%}
    <span class="split-slider__divider" aria-hidden="true">
      {%- unless s.handle_style == 'line' -%}
        <span class="split-slider__handle">
          {%- if s.orientation == 'vertical' -%}
            {%- render 'icon', icon: 'chevron-up' -%}{%- render 'icon', icon: 'chevron-down' -%}
          {%- else -%}
            {%- render 'icon', icon: 'chevron-left' -%}{%- render 'icon', icon: 'chevron-right' -%}
          {%- endif -%}
        </span>
      {%- endunless -%}
    </span>
    <input
      class="split-slider__range visually-hidden"
      type="range"
      min="0"
      max="100"
      value="{{ s.start }}"
      aria-label="{{ 'sections.before_after.slider_label' | t }}"
      {% if s.orientation == 'vertical' %}aria-orientation="vertical"{% endif %}
    >
  </split-slider>
  {%- if s.caption != blank -%}
    <figcaption class="split-slider-block__caption">{{ s.caption }}</figcaption>
  {%- endif -%}
</figure>
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

