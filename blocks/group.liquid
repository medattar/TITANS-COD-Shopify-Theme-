        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "tx_size",
      "label": "Font size, desktop (0 = default)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_size_m",
      "label": "Font size, mobile (0 = default)",
      "min": 0,
      "max": 96,
