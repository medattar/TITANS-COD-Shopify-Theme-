{%- liquid
  assign s = block.settings
  case s.ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '4 / 3'
    when 'wide'
      assign ratio = '16 / 9'
    else
      if s.image != blank
        assign ratio = s.image.aspect_ratio
      else
        assign ratio = '4 / 3'
      endif
  endcase
  assign img_sizes = '(min-width: 990px) ' | append: s.width | append: 'vw, 100vw'
-%}
<figure
  class="image-block{% if s.border %} image-block--border{% endif %}{% if s.shadow %} image-block--shadow{% endif %}"
  style="--ib-width: {{ s.width }}%; --ib-width-m: {{ s.width_mobile }}%; --ib-radius: {{ s.radius }}px; --ib-align: {{ s.align }};"
  {{ block.shopify_attributes }}
>
  {%- if s.link != blank -%}<a href="{{ s.link }}" class="image-block__link">{%- endif -%}
  <div class="media" style="--ratio: {{ ratio }};">
    {%- if s.image != blank -%}
      {%- render 'image', image: s.image, sizes: img_sizes, alt: s.alt -%}
    {%- else -%}
      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  {%- if s.link != blank -%}</a>{%- endif -%}
  {%- if s.caption != blank -%}
    <figcaption class="image-block__caption">{{ s.caption }}</figcaption>
  {%- endif -%}
</figure>

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "alt", "label": "Alt text override" },
    {
      "type": "select", "id": "ratio", "label": "Aspect ratio", "default": "adapt",
      "options": [
        { "value": "adapt", "label": "Original" }, { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait 4:5" }, { "value": "landscape", "label": "Landscape 4:3" }, { "value": "wide", "label": "Wide 16:9" }
      ]
    },
    { "type": "range", "id": "width", "label": "Width (desktop)", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "width_mobile", "label": "Width (mobile)", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [ { "value": "flex-start", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "flex-end", "label": "Right" } ]
    },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 18 },
    { "type": "checkbox", "id": "border", "label": "Border", "default": false },
    { "type": "checkbox", "id": "shadow", "label": "Shadow", "default": false },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "inline_richtext", "id": "caption", "label": "Caption" }
  ],
  "presets": [{ "name": "Image" }]
}
{% endschema %}
