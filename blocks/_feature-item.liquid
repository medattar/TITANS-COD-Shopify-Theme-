{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- assign c = block.settings -%}
<li class="feature-list__item" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if c.image != blank -%}
    <span class="feature-list__icon" aria-hidden="true">
      {{- c.image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '', width: 48, height: 48 -}}
    </span>
  {%- elsif c.icon == 'inherit' -%}
    <span class="feature-list__icon feature-list__icon--inherit" aria-hidden="true"></span>
  {%- elsif c.icon == 'glyph' -%}
    <span class="feature-list__icon feature-list__icon--glyph" aria-hidden="true"></span>
  {%- elsif c.icon != 'none' -%}
    <span class="feature-list__icon" aria-hidden="true">{%- render 'icon', icon: c.icon -%}</span>
  {%- endif -%}
  <span class="feature-list__text">{{ c.text }}</span>
</li>

