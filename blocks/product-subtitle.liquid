{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product | default: product
  assign s = block.settings
  assign lines = s.lines | newline_to_br | split: '<br />'
  assign highlight_list = p.metafields.custom.highlights.value
-%}
{%- capture fs -%}[data-box="{{ block.id }}"] :is(.product-subtitle__lead, .product-subtitle__list, .product-subtitle__list li){%- endcapture -%}
{%- render 'block-font-size', sel: fs, mobile: s.size_mobile, desktop: s.size_desktop -%}
<div class="product-subtitle" style="--ps-size-d: {{ s.size_desktop }}px; --ps-size-m: {{ s.size_mobile }}px;" data-box="{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if s.text != blank -%}
    <p class="product-subtitle__lead">{{ s.text }}</p>
  {%- endif -%}
  {%- if s.source == 'metafield' and highlight_list != blank -%}
    <ul class="product-subtitle__list" role="list" style="--ps-marker: '{{ s.marker }}';">
      {%- for item in highlight_list -%}
        <li>{{ item }}</li>
      {%- endfor -%}
    </ul>
  {%- elsif s.source == 'manual' and s.lines != blank -%}
    <ul class="product-subtitle__list" role="list" style="--ps-marker: '{{ s.marker }}';">
      {%- for line in lines -%}
        {%- assign line_text = line | strip -%}
        {%- if line_text != blank -%}
          <li>{{ line_text }}</li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
