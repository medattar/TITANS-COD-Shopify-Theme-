{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign s = block.settings
  assign classes = 'heading-block ' | append: s.size
  if s.font != 'inherit'
    assign classes = classes | append: ' font-' | append: s.font
  endif
  if s.effect != 'none'
    assign classes = classes | append: ' fx-' | append: s.effect
  endif
  if s.transform != 'inherit'
    assign classes = classes | append: ' tt-' | append: s.transform
  endif
-%}
{%- if s.text != blank -%}
  <{{ s.tag }}
    class="{{ classes }}"
    style="text-align: {{ s.align }}; --hb-color: var(--color-{{ s.color }});{% if s.size == 'custom' %} --hb-size-d: {{ s.size_desktop }}px; --hb-size-m: {{ s.size_mobile }}px;{% endif %}{% if s.max_width > 0 %} max-width: {{ s.max_width }}px;{% if s.align == 'center' %} margin-inline: auto;{% endif %}{% endif %}"
    data-box="{{ block.id }}" {{ block.shopify_attributes }}
  >
    {{- s.text -}}
  </{{ s.tag }}>
{%- endif -%}
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

