{%- liquid
  assign s = block.settings
  assign classes = 'heading-block ' | append: s.size
  if s.font != 'inherit'
    assign classes = classes | append: ' font-' | append: s.font
  endif
  if s.effect != 'none'
    assign classes = classes | append: ' fx-' | append: s.effect
  endif
  if s.transform != 'inherit'
    assign classes = classes | append: ' tt-' | append: s.transform
  endif
-%}
{%- if s.text != blank -%}
  <{{ s.tag }}
    class="{{ classes }}"
    style="text-align: {{ s.align }}; --hb-color: var(--color-{{ s.color }});{% if s.size == 'custom' %} --hb-size-d: {{ s.size_desktop }}px; --hb-size-m: {{ s.size_mobile }}px;{% endif %}{% if s.max_width > 0 %} max-width: {{ s.max_width }}px;{% if s.align == 'center' %} margin-inline: auto;{% endif %}{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{- s.text -}}
  </{{ s.tag }}>
{%- endif -%}

{% schema %}
{
  "name": "Heading",
  "tag": null,
  "settings": [
    { "type": "inline_richtext", "id": "text", "label": "Heading", "default": "Escribe un titular", "info": "Italic text uses the accent style from Theme settings > Text effects" },
    {
      "type": "select", "id": "size", "label": "Size", "default": "h2",
      "options": [
        { "value": "h1", "label": "Heading 1" }, { "value": "h2", "label": "Heading 2" },
        { "value": "h3", "label": "Heading 3" }, { "value": "h4", "label": "Heading 4" }, { "value": "custom", "label": "Custom" }
      ]
    },
    { "type": "range", "id": "size_desktop", "label": "Custom size (desktop)", "min": 14, "max": 120, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "size_mobile", "label": "Custom size (mobile)", "min": 14, "max": 80, "step": 1, "unit": "px", "default": 32 },
    {
      "type": "select", "id": "font", "label": "Font", "default": "inherit",
      "options": [
        { "value": "inherit", "label": "Size default" }, { "value": "display", "label": "Display" },
        { "value": "heading", "label": "Heading" }, { "value": "body", "label": "Body" }
      ]
    },
    {
      "type": "select", "id": "transform", "label": "Letter case", "default": "inherit",
      "options": [ { "value": "inherit", "label": "Default" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "none", "label": "As typed" } ]
    },
    {
      "type": "select", "id": "color", "label": "Color", "default": "heading",
      "options": [
        { "value": "heading", "label": "Heading" }, { "value": "text", "label": "Text" },
        { "value": "accent", "label": "Accent" }, { "value": "muted", "label": "Muted" }, { "value": "highlight", "label": "Highlight" }
      ]
    },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ]
    },
    { "type": "range", "id": "max_width", "label": "Max width (0 = none)", "min": 0, "max": 1200, "step": 20, "unit": "px", "default": 0 },
    {
      "type": "select", "id": "effect", "label": "Entrance effect", "default": "none",
      "options": [
        { "value": "none", "label": "None" }, { "value": "fade", "label": "Fade" }, { "value": "slide", "label": "Slide up" },
        { "value": "reveal", "label": "Wipe reveal" }, { "value": "typewriter", "label": "Typewriter" }
      ]
    },
    {
      "type": "select", "id": "tag", "label": "HTML tag", "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" }, { "value": "p", "label": "Paragraph" }
      ]
    }
  ],
  "presets": [{ "name": "Heading" }]
}
{% endschema %}
