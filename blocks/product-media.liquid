{%- liquid
  assign p = closest.product | default: product
  assign s = block.settings
  assign desk = s.desktop_position | default: 'flow'
  assign col_split = s.column_split | default: '1.05fr 1fr'
  assign gal_share = 0.512195
  case col_split
    when '1fr 1fr'
      assign gal_share = 0.5
    when '1.05fr 1fr'
      assign gal_share = 0.512195
    when '1.25fr 1fr'
      assign gal_share = 0.555556
    when '1.5fr 1fr'
      assign gal_share = 0.6
    when '1fr 1.15fr'
      assign gal_share = 0.465116
  endcase
  assign col_right = col_split | split: ' ' | reverse | join: ' '
-%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
<style>
  #shopify-section-{{ section.id }} .product {
    --product-max: {{ s.flow_width | default: 760 }}px;
    {%- if desk == 'left' or desk == 'right' -%}
      --product-cols: {{ col_split }};
      --product-cols-right: {{ col_right }};
      --product-gap: {{ s.column_gap | default: 56 }}px;
      --gal-share: {{ gal_share }};
    {%- endif -%}
  }
</style>
<section class="pm-slot">
<div
  class="product-media-block product-media-block--desk-{{ desk }}{% if s.sticky %} product-media-block--sticky{% endif %}{% if desk != 'flow' and s.column_sticky %} product-media-block--col-sticky{% endif %}"
  style="--pm-width: {{ s.width }}%; --pm-width-m: {{ s.width_mobile }}%;"
  data-box="{{ block.id }}" {{ block.shopify_attributes }}
>
  {%- if p != blank -%}
    {%- render 'product-media-gallery',
      product: p,
      section: section,
      priority: s.priority,
      layout: s.layout,
      arrows: s.arrows,
      arrows_mobile: s.arrows_mobile,
      counter: s.counter,
      gap: s.gap,
      ratio: s.ratio,
      radius: s.radius
    -%}
  {%- elsif request.design_mode -%}
    <div class="gallery__viewer">
      <div class="gallery__media media placeholder">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
    </div>
  {%- endif -%}
</div>
</section>

{% schema %}
{
