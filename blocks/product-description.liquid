{%- liquid
  assign show_here = true
  if block.settings.show_on == 'selected'
    assign show_here = false
    assign show_for = block.settings.product | default: product
    assign show_ids = block.settings.show_products | map: 'id'
    if show_for and show_ids contains show_for.id
      assign show_here = true
    endif
  endif
-%}
{%- if show_here -%}
{%- capture box_sel -%}[data-box="{{ block.id }}"]{%- endcapture -%}
{%- render 'box-style', bs: block.settings, sel: box_sel, clip: true -%}
{%- liquid
  assign p = closest.product
  if block.settings.product.id != blank
    assign p = block.settings.product
  endif
  assign s = block.settings
-%}
{%- if p.description != blank -%}
  <div
    class="product-description"
    style="{% if s.img_radius_custom %}--img-tl: {{ s.img_radius_tl }}px; --img-tr: {{ s.img_radius_tr }}px; --img-br: {{ s.img_radius_br }}px; --img-bl: {{ s.img_radius_bl }}px;{% endif %}{% if s.img_border_width > 0 %}--img-border: {{ s.img_border_width }}px; --img-border-color: {{ s.img_border_color | default: 'currentColor' }};{% endif %}{% if s.img_shadow %}--img-shadow: var(--shadow-medium);{% endif %}"
    data-box="{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {%- if s.heading != blank -%}<h3 class="product-description__heading">{{ s.heading }}</h3>{%- endif -%}
    {%- if s.collapsible -%}
      <details class="product-description__more">
        <summary>
          <div class="rte product-description__preview">{{ p.description | strip_html | truncatewords: s.preview_words }}</div>
          <span class="link">{{ 'products.product.read_more' | t }}</span>
        </summary>
        <div class="rte">{% render 'lazy-content', html: p.description %}</div>
      </details>
    {%- else -%}
      <div class="rte">{% render 'lazy-content', html: p.description %}</div>
    {%- endif -%}
  </div>
{%- else -%}
  {%- render 'block-placeholder', message: 'Product description appears when the product has a description.' -%}
{%- endif -%}
{%- else -%}
  {%- render 'block-placeholder', message: 'Hidden on this product. Change Show on to display it here.' -%}
{%- endif -%}

{% schema %}
{
  "name": "Product description",
  "tag": null,
  "settings": [
    {"type": "select", "id": "show_on", "label": "Show on", "default": "all", "options": [{"value": "all", "label": "All products"}, {"value": "selected", "label": "Only the products below"}]},
    {"type": "product_list", "id": "show_products", "label": "Products", "limit": 50, "info": "Used when Show on is set to Only the products below."},
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Show preview with \"Read more\"",
      "default": false
    },
    {
      "type": "range",
      "id": "preview_words",
      "label": "Preview length (words)",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Description images"
    },
    {
      "type": "checkbox",
      "id": "img_radius_custom",
      "label": "Custom corner radius on images",
      "default": false
    },
    {
      "type": "range",
      "id": "img_radius_tl",
      "label": "Image top left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.img_radius_custom }}"
    },
    {
      "type": "range",
      "id": "img_radius_tr",
      "label": "Image top right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.img_radius_custom }}"
    },
    {
      "type": "range",
      "id": "img_radius_br",
      "label": "Image bottom right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.img_radius_custom }}"
    },
    {
      "type": "range",
      "id": "img_radius_bl",
      "label": "Image bottom left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.img_radius_custom }}"
    },
    {
      "type": "range",
      "id": "img_border_width",
      "label": "Image border width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "img_border_color",
      "label": "Image border color"
    },
    {
      "type": "checkbox",
      "id": "img_shadow",
      "label": "Image shadow",
      "default": false
    },
    {
      "type": "header",
      "content": "Box style"
    },
    {
      "type": "checkbox",
      "id": "box_enable",
      "label": "Customize spacing, border and shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "box_mt",
      "label": "Space above (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb",
      "label": "Space below (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mt_m",
      "label": "Space above (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_mb_m",
      "label": "Space below (mobile)",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py",
      "label": "Inner padding top/bottom (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px",
      "label": "Inner padding left/right (desktop)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_py_m",
      "label": "Inner padding top/bottom (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_px_m",
      "label": "Inner padding left/right (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "range",
      "id": "box_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "box_radius_split",
      "label": "Different radius on each corner",
      "default": false,
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "range",
      "id": "box_radius_tl",
      "label": "Top left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_tr",
      "label": "Top right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_br",
      "label": "Bottom right radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_radius_bl",
      "label": "Bottom left radius",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.box_enable and block.settings.box_radius_split }}"
    },
    {
      "type": "range",
      "id": "box_border_width",
      "label": "Border width",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_border_style",
      "label": "Border style",
      "default": "solid",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        },
        {
          "value": "double",
          "label": "Double"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_border_color",
      "label": "Border color",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "color",
      "id": "box_bg",
      "label": "Background color",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "color_background",
      "id": "box_bg_gradient",
      "label": "Background gradient",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_shadow",
      "label": "Shadow",
      "default": "none",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "hard",
          "label": "Hard (offset)"
        },
        {
          "value": "glow",
          "label": "Glow"
        }
      ]
    },
    {
      "type": "color",
      "id": "box_shadow_color",
      "label": "Shadow color",
      "default": "#000000",
      "visible_if": "{{ block.settings.box_enable }}"
    },
    {
      "type": "select",
      "id": "box_effect",
      "label": "Hover effect",
      "default": "none",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "grow",
          "label": "Grow"
        },
        {
          "value": "glow",
          "label": "Glow"
        },
        {
          "value": "dim",
          "label": "Dim"
        }
      ]
    },
    {
      "type": "range",
      "id": "box_max_width",
      "label": "Max width (0 = full)",
      "min": 0,
      "max": 1600,
      "step": 20,
      "default": 0,
      "visible_if": "{{ block.settings.box_enable }}",
      "unit": "px"
    },
    {
      "type": "select",
      "id": "box_align",
      "label": "Position when narrower",
      "default": "center",
      "visible_if": "{{ block.settings.box_enable }}",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "checkbox",
      "id": "tx_enable",
      "label": "Customize fonts and spacing",
      "default": false
    },
    {
      "type": "select",
      "id": "tx_font",
      "label": "Font",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "display",
          "label": "Display"
        },
        {
          "value": "heading",
          "label": "Heading"
        },
        {
          "value": "body",
          "label": "Body"
        }
      ]
    },
    {
      "type": "select",
      "id": "tx_weight",
      "label": "Weight",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
        {
          "value": "inherit",
          "label": "Default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        },
        {
          "value": "900",
          "label": "Black"
        }
      ]
    },
    {
      "type": "range",
      "id": "tx_size",
      "label": "Font size, desktop (0 = default)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_size_m",
      "label": "Font size, mobile (0 = default)",
      "min": 0,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_letter",
      "label": "Letter spacing (1/100 em)",
      "min": -10,
      "max": 40,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_word",
      "label": "Word spacing (1/100 em)",
      "min": -20,
      "max": 100,
      "step": 2,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "range",
      "id": "tx_line",
      "label": "Line height (10 = 1.0, 0 = default)",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 0,
      "visible_if": "{{ block.settings.tx_enable }}"
    },
    {
      "type": "select",
      "id": "tx_transform",
      "label": "Letter case",
      "default": "inherit",
      "visible_if": "{{ block.settings.tx_enable }}",
      "options": [
